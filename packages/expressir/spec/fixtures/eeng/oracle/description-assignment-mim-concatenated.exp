SCHEMA mesh_topology_schema '{iso standard 10303 part(52) version(5) object(1) mesh-topology-schema(3)}';
  REFERENCE FROM mathematical_description_of_distribution_schema  -- ISO 10303-51
    (property_distribution_description);
  REFERENCE FROM mathematical_functions_schema                    -- ISO 10303-50
    (maths_space,
     tuple_space);
  REFERENCE FROM structural_response_representation_schema        -- ISO 10303-104
    (element_order,
     element_representation,
     fea_model);
  REFERENCE FROM support_resource_schema                          -- ISO 10303-41
    (identifier,
     label,
     text);
  REFERENCE FROM topology_schema                                  -- ISO 10303-42
    (topological_representation_item,
     vertex,  vertex_point);

TYPE cell_shape = EXTENSIBLE SELECT
    (cell_shape_0D,
     cell_shape_1D,
     cell_shape_2D,
     cell_shape_3D);
END_TYPE;

TYPE cell_shape_0D = EXTENSIBLE ENUMERATION OF
    (single);
END_TYPE;

TYPE cell_shape_1D = EXTENSIBLE ENUMERATION OF
    (line);
END_TYPE;

TYPE cell_shape_2D = EXTENSIBLE ENUMERATION OF
    (quadrilateral,
     triangle);
END_TYPE;

TYPE cell_shape_3D = EXTENSIBLE ENUMERATION OF
    (hexahedron,
     wedge,
     tetrahedron,
     pyramid);
END_TYPE;

TYPE indices_group = SELECT
     (indices_list,
      indices_range);
END_TYPE;

TYPE mesh_location = EXTENSIBLE ENUMERATION OF
     (unspecified,
      application_defined,
      vertices,
      cell_centre,
      face_centre,
      iface_centre,
      jface_centre,
      kface_centre,
      edge_centre);
END_TYPE;

TYPE mesh_maths_space_type = EXTENSIBLE ENUMERATION OF
     (cells,
      vertices);
END_TYPE;

TYPE structured_mesh_type = EXTENSIBLE ENUMERATION OF
    (rectangular,
     pentahedral,
     pyramidal,
     tetrahedral);
END_TYPE;

TYPE mesh_tuple_space = EXTENSIBLE GENERIC_ENTITY SELECT BASED_ON tuple_space WITH
  (mesh_derived_maths_space);
END_TYPE;

ENTITY array_based_unstructured_mesh
  SUBTYPE OF (unstructured_mesh);
  cells        : ARRAY [1:SELF\unstructured_mesh.cell_count] OF vertex_defined_cell;
WHERE
  WR1 : SELF\mesh.index_count = 1;
END_ENTITY;

ENTITY array_based_unstructured_mesh_and_vertices
  SUBTYPE OF (array_based_unstructured_mesh);
  vertex_count : INTEGER;
  vertices     : ARRAY [1:vertex_count] OF UNIQUE vertex;
WHERE
  WR1 : all_mesh_vertices(SELF);
END_ENTITY;

ENTITY cell
  SUPERTYPE OF (ONEOF(cell_of_structured_mesh, vertex_defined_cell))
  SUBTYPE OF (topological_representation_item);
  description : text;
  dimension   : INTEGER;
END_ENTITY;

ENTITY cell_with_explicit_boundary
  SUBTYPE OF (cell);
  boundary : SET [1:?] OF topological_representation_item;
END_ENTITY;

ENTITY cell_of_structured_mesh
  SUBTYPE OF (cell);
  the_mesh : structured_mesh;
  cell_identifier : ARRAY [1:index_count] OF INTEGER;
DERIVE
  index_count : INTEGER := the_mesh\mesh.index_count;
END_ENTITY;

ENTITY explicit_unstructured_mesh
  SUBTYPE OF (unstructured_mesh);
  explicit_model : fea_model;
  cells          : ARRAY [1:SELF\unstructured_mesh.cell_count] OF UNIQUE element_representation;
END_ENTITY;

ENTITY extraction_of_structured_submesh
SUBTYPE OF(extraction_of_submesh);
  lower_vertex : ARRAY [1:whole_indices] OF INTEGER;
  used_indices : ARRAY [1:part_indices] OF INTEGER;
  used_senses  : ARRAY [1:part_indices] OF BOOLEAN;
DERIVE
  whole_indices : INTEGER := SELF\extraction_of_submesh.whole\mesh.index_count;
  part_indices  : INTEGER := SELF\extraction_of_submesh.part\mesh.index_count;
WHERE
  WR1: ('MESH_TOPOLOGY_SCHEMA.STRUCTURED_MESH' IN  TYPEOF(
             SELF\extraction_of_submesh.whole));
  WR2: ('MESH_TOPOLOGY_SCHEMA.STRUCTURED_MESH' IN  TYPEOF(
             SELF\extraction_of_submesh.part));

END_ENTITY;

ENTITY extraction_of_submesh;
   whole:  mesh;
   part:   submesh;
END_ENTITY;


ENTITY extraction_of_submesh_by_cells
  SUBTYPE OF (extraction_of_submesh);
  cell_count: INTEGER;
  cells : ARRAY [1:cell_count] OF cell;
END_ENTITY;

ENTITY extraction_of_submesh_by_vertices
  SUBTYPE OF (extraction_of_submesh);
  vertex_count: INTEGER;
  vertices : ARRAY [1:vertex_count] OF vertex;
END_ENTITY;

ENTITY indices_list;
  nindices : INTEGER;
  indices  : LIST [1:?] OF ARRAY [1:nindices] OF INTEGER;
END_ENTITY;

ENTITY indices_range;
  nindices : INTEGER;
  start    : ARRAY [1:nindices] OF INTEGER;
  finish   : ARRAY [1:nindices] OF INTEGER;
END_ENTITY;

ENTITY mesh
  ABSTRACT SUPERTYPE OF (ONEOF(structured_mesh,
        unstructured_mesh) ANDOR submesh)
   SUBTYPE OF (topological_representation_item);
  description : text;
  index_count : INTEGER;
END_ENTITY;

ENTITY mesh_derived_maths_space
  SUBTYPE OF (maths_space);
  description : text;
  name        : label;
  id          : identifier;
  the_mesh    : mesh;
  kind        : mesh_maths_space_type;
END_ENTITY;

ENTITY product_of_mesh;
  operands : LIST [2:2] OF mesh;
  product  : mesh;
WHERE
  WR1 : ('MESH_TOPOLOGY_SCHEMA.STRUCTURED_MESH' IN TYPEOF(operands[1])) AND
        ('MESH_TOPOLOGY_SCHEMA.STRUCTURED_MESH' IN TYPEOF(operands[2])) AND
        ('MESH_TOPOLOGY_SCHEMA.STRUCTURED_MESH' IN TYPEOF(product));
  WR2 : operands[1].index_count = 1;
  WR3 : operands[1].index_count + operands[2].index_count
        = product.index_count;
END_ENTITY;

ENTITY rind;
  index_count : INTEGER;
  planes      : ARRAY [1:2*index_count] OF INTEGER;
END_ENTITY;

ENTITY structured_mesh
  SUBTYPE OF (mesh);
  vertex_counts : ARRAY [1:SELF\mesh.index_count] OF INTEGER;
  cell_counts   : ARRAY [1:SELF\mesh.index_count] OF INTEGER;
  kind          : structured_mesh_type;
END_ENTITY;

ENTITY structured_mesh_with_rind
  SUBTYPE OF (structured_mesh);
  rind_planes : rind;
END_ENTITY;

ENTITY submesh
  SUBTYPE OF (mesh);
END_ENTITY;

ENTITY unstructured_mesh
  ABSTRACT SUPERTYPE OF (ONEOF(array_based_unstructured_mesh,
         explicit_unstructured_mesh))
  SUBTYPE OF (mesh);
  cell_count : INTEGER;
END_ENTITY;

ENTITY vertex_defined_cell
  SUBTYPE OF (cell);
  shape       : cell_shape;
  order       : element_order;
  vertices    : ARRAY [1:vn_count] OF OPTIONAL vertex;
DERIVE
  bound_count       : INTEGER := cell_counts(SELF)[1];
  edge_node_count   : INTEGER := cell_counts(SELF)[2];
  opt_node_count    : INTEGER := cell_counts(SELF)[3];
  required_count    : INTEGER := bound_count + edge_node_count;
  vn_count          : INTEGER := required_count + opt_node_count;
  required_vertices : ARRAY [1:required_count] OF vertex
                        := shorten_array(vertices, vn_count, required_count);
END_ENTITY;

(*
ENTITY vertex_range_defined_patch
  SUBTYPE OF (patch);
  base_mesh : structured_mesh;
  range     : indices_range;
END_ENTITY;
*)

FUNCTION all_mesh_vertices(arg : array_based_unstructured_mesh_and_vertices)
         : BOOLEAN;
LOCAL
  vertex_set : SET OF vertex := [];
  cell : vertex_defined_cell;
END_LOCAL;
  REPEAT i := 1 TO arg.cell_count;
    cell := arg.cells[i];
    REPEAT j := 1 TO cell.vn_count;
      vertex_set := vertex_set + cell.vertices[j];
    END_REPEAT;
  END_REPEAT;
  IF (SIZEOF(vertex_set) <> arg.index_count) THEN
    RETURN(FALSE);
  END_IF;
  REPEAT i := 1 TO arg.index_count;
    IF (NOT (arg.vertices[i] IN vertex_set) ) THEN
      RETURN(FALSE);
    END_IF;
  END_REPEAT;
  RETURN(TRUE);
END_FUNCTION;

FUNCTION cell_counts(arg : vertex_defined_cell) : ARRAY[1:3] OF INTEGER;
LOCAL
  om1    : INTEGER := 0;      -- (order - 1)
  om1sq  : INTEGER := om1**2; -- (order - 1) squared
  vts    : INTEGER;           -- number of bounding vertices
  eds    : INTEGER;           -- number of edges
  qf     : INTEGER := 0;      -- number of quadrilateral faces
  tf     : INTEGER := 0;      -- number of triangular faces
  result : ARRAY [1:3] OF INTEGER := [0,0,0];
END_LOCAL;
  CASE arg\vertex_defined_cell.order OF
    element_order.linear    : om1 := 0;
    element_order.quadratic : om1 := 1;
    element_order.cubic     : om1 := 2;
    OTHERWISE : RETURN(result);
  END_CASE;
  om1sq := om1**2;
  CASE arg\vertex_defined_cell.shape OF
    cell_shape_0D.single :
        BEGIN
          vts := 1; eds := 0; qf := 0; tf := 0;
          result[1] := vts;
          result[2] := om1*eds;                   -- 0, 0, 0
          result[3] := 0;                         -- 0, 0, 0
        END;
    cell_shape_1D.line :
        BEGIN
          vts := 2; eds := 1; qf := 0; tf := 0;
          result[1] := vts;
          result[2] := om1*eds;                   -- 0, 1, 2
          result[3] := 0;                         -- 0, 0, 0
        END;
    cell_shape_2D.quadrilateral :
        BEGIN
          vts := 4; eds := 4; qf := 1; tf := 0;
          result[1] := vts;
          result[2] := om1*eds;                   -- 0, 4, 8
          result[3] := om1sq*qf;                  -- 0, 1, 4
        END;
    cell_shape_2D.triangle :
        BEGIN
          vts := 3; eds := 3; qf := 0; tf := 1;
          result[1] := vts;
          result[2] := om1*eds;                   -- 0, 3, 6
          result[3] := (om1-1)*tf;                --    0, 1
          CASE arg\vertex_defined_cell.order OF
            element_order.linear : result[3] := 0; -- 0
          END_CASE;
        END;
    cell_shape_3D.hexahedron :
        BEGIN
          vts := 8; eds := 12; qf := 6; tf := 0;
          result[1] := vts;
          result[2] := om1*eds;                   -- 0, 12, 24
          result[3] := om1sq*(qf+om1);            -- 0, 7, 32
        END;
    cell_shape_3D.wedge :
        BEGIN
          vts := 6; eds := 9; qf := 3; tf := 2;
          result[1] := vts;
          result[2] := om1*eds;                   -- 0, 9,  18
          result[3] := om1sq*qf + om1*tf;         -- 0, 3, 16
        END;
    cell_shape_3D.tetrahedron :
        BEGIN
          vts := 4; eds := 6; qf := 0; tf := 4;
          result[1] := vts;
          result[2] := om1*eds;                   -- 0, 6, 12
          result[3] := (om1-1)*tf;                --    0, 4
          CASE arg\vertex_defined_cell.order OF
            element_order.linear : result[3] := 0;-- 0
          END_CASE;
        END;
    cell_shape_3D.pyramid :
        BEGIN
          vts := 5; eds := 8; qf := 1; tf := 4;
          result[1] := vts;
          result[2] := om1*eds;                   -- 0, 8, 16
          result[3] := om1sq*qf + (om1-1)*tf;     --    1, 9
          CASE arg\vertex_defined_cell.order OF
            element_order.linear : result[3] := 0; -- 0
          END_CASE;
        END;
  END_CASE;
RETURN(result);
END_FUNCTION;

FUNCTION shorten_array(longa : ARRAY OF GENERIC : T;
                      oldl, newl : INTEGER) : ARRAY OF GENERIC : T;
   LOCAL
     shorta : ARRAY [1:newl] OF GENERIC : T;
   END_LOCAL;

   IF (newl > oldl) THEN
     RETURN(?);
   ELSE
     REPEAT i := 1 TO newl;
       shorta[i] := longa[i];
     END_REPEAT;
     RETURN(shorta);
   END_IF;
END_FUNCTION;

END_SCHEMA;  -- end of mesh_topology_schema



(*"mesh_topology_schema.__fund_cons"

==== General

A mesh is defined by its vertices and the connections between the vertices. A mesh is a connected graph.

==== Structured mesh

In a structured mesh the cells are arranged in a regular pattern and their shapes are implied by the particular kind of mesh.

A 3-D rectangular mesh is a mesh of hexahedral cells. Each cell is a dimensionality 3 hexahedral region defined by eight vertices forming the corners of the hexahedron. Each cell is bounded by six faces, where each face is the quadrilateral defined by four vertices. A face is limited by the four edges that connect the four vertices.

[[figure-mesh_topology_schema-fig2]]
.Example convention for a 2-D cell center
image::images/fig02.svg[]

[[figure-mesh_topology_schema-fig3]]
.Example mesh with rind vertices
image::images/fig03.svg[]

A 2-D rectangular mesh is a mesh of quadrilaterals. Each cell is a dimensionality two quadrilateral region defined by four vertices forming the corners of the quadrilateral. Each cell is limited by the four edges that connect the four vertices.

A 1-D mesh is of linear form. Each cell is a dimensionality one linear region bounded by two vertices.

Indices describing a structured mesh are ordered: for 3-D stem:[(i, j, k)]; stem:[(i, j)] is used for 2-D; and stem:[(i)] for 1-D.

Cell centres, face centres, and edge centres are indexed by the minimum of the connecting vertices.

[example]
====
For example a 2-D cell center (or face center on a 3-D mesh) would have the conventions shown in <<figure-mesh_topology_schema-fig2>>.
====

In addition, the default beginning vertex for a regular mesh is stem:[(1, 1, 1)]; this means the default beginning cell center of a regular mesh is also stem:[(1, 1, 1)].

There may be locations outside the mesh itself. These are referred to as 'rind' or ghost points and may be associated with fictitious vertices or cell centres. They are distinguished from the vertices and cells making up the mesh (including its boundary vertices), which are referred to as 'core' points.

[example]
====
<<figure-mesh_topology_schema-fig3>> shows a 2-D mesh with a single row of 'rind' vertices at the minimum and maximum stem:[i]-faces. The mesh size (i.e., the number of 'core' vertices in each direction) is stem:[5 xx 4]. 'Core' vertices are designated by '•', and 'rind' vertices by 'stem:[xx]'. Default indexing is also shown for the vertices.
====

For a mesh, the minimum faces in each coordinate direction are denoted stem:[i]-min, stem:[j]-min and stem:[k]-min; the maximum faces are denoted stem:[i]-max, stem:[j]-max and stem:[k]-max. These are the minimum and maximum 'core' faces.

[example]
====
stem:[i]-min is the face or mesh plane whose core vertices have minimum stem:[i] index (which if using default indexing is 1).
====

==== Unstructured mesh

An unstructured mesh is composed of cells, where the cells need not form a regular pattern and the shape of the cells is not restricted to be uniform throughout the mesh. Cells have vertices at their corners and may also have nodes on cell edges, cell faces, and in the interior of the cell.

Each cell in an irregular mesh has at least one vertex in common with at least one other cell in the mesh. The connectivity and adjacency of the cells may be determined from the common vertices.

Each cell in an unstructured mesh is explicitly represented in terms of its shape and an ordered list of its vertices. The vertices are implied rather than being explicitly represented. Essentially all the vertices in a mesh can be mapped to a sequential list, and reference to a vertex is then equivalent to specifying the particular position in the list.

*)

(*"mesh_topology_schema.cell_shape"

A <<express:mesh_topology_schema.cell_shape,cell_shape>> is an identifier of an unstructured mesh cell shape.

*)

(*"mesh_topology_schema.cell_shape_0D"

A <<express:mesh_topology_schema.cell_shape_0D,cell_shape_0D>> is an identifier of a topologically 0-D unstructured mesh cell shape.

*)

(*"mesh_topology_schema.cell_shape_0D.single"

singleton vertex.

*)

(*"mesh_topology_schema.cell_shape_1D"

A <<express:mesh_topology_schema.cell_shape_1D,cell_shape_1D>> is an identifier of a topologically 1-D unstructured mesh cell shape.

*)

(*"mesh_topology_schema.cell_shape_1D.line"

a topological line requiring 2 vertices.

*)

(*"mesh_topology_schema.cell_shape_2D"

A <<express:mesh_topology_schema.cell_shape_2D,cell_shape_2D>> is an identifier of a topologically 2-D unstructured mesh cell shape.

*)

(*"mesh_topology_schema.cell_shape_2D.quadrilateral"

four sided cell requiring 4 vertices;

*)

(*"mesh_topology_schema.cell_shape_2D.triangle"

three sided cell requiring 3 vertices;

NOTE: This type is defined as EXTENSIBLE to enable other 2D cell shapes to be added to the list as required by particular applications.

*)

(*"mesh_topology_schema.cell_shape_3D"

A <<express:mesh_topology_schema.cell_shape_3D,cell_shape_3D>> is an identifier of a topologically 3-D unstructured mesh cell shape.

*)

(*"mesh_topology_schema.cell_shape_3D.hexahedron"

hexahedral (six quadrilateral faces) requiring 8 vertices;

*)

(*"mesh_topology_schema.cell_shape_3D.wedge"

pentahedral (three quadrilateral faces and two triangular faces) requiring 6 vertices;

*)

(*"mesh_topology_schema.cell_shape_3D.tetrahedron"

tetrahedral form (four triangular faces) requiring 4 vertices;

*)

(*"mesh_topology_schema.cell_shape_3D.pyramid"

pyramidal form (one quadrilateral face and four triangular faces) requiring 5 vertices.

NOTE: This type is defined as EXTENSIBLE to enable other 3D cell shapes to be added to the list as required by particular applications.

*)

(*"mesh_topology_schema.indices_group"

An <<express:mesh_topology_schema.indices_group,indices_group>> is a selection of a group of indices into a multi-dimensional array.

*)

(*"mesh_topology_schema.mesh_location"

A <<express:mesh_topology_schema.mesh_location,mesh_location>> is an enumeration of locations with respect to a mesh.

*)

(*"mesh_topology_schema.mesh_location.unspecified"

not specified;

*)

(*"mesh_topology_schema.mesh_location.application_defined"

specified via an external agreement between the data creator and the data user;

*)

(*"mesh_topology_schema.mesh_location.vertices"

at cell vertices for cells within the mesh;

*)

(*"mesh_topology_schema.mesh_location.cell_centre"

the centre of a cell; this is also appropriate for entities associated with cells but not necessarily with a given location in a cell;

*)

(*"mesh_topology_schema.mesh_location.face_centre"

the centre of a generic face which can point in any coordinate direction;

*)

(*"mesh_topology_schema.mesh_location.iface_centre"

the center of a face in 3-D whose computational normal points in the stem:[i] direction;

*)

(*"mesh_topology_schema.mesh_location.jface_centre"

the center of a face in 3-D whose computational normal points in the stem:[j] direction;

*)

(*"mesh_topology_schema.mesh_location.kface_centre"

the center of a face in 3-D whose computational normal points in the stem:[k] direction;

*)

(*"mesh_topology_schema.mesh_location.edge_centre"

the center of an edge.

*)

(*"mesh_topology_schema.mesh_maths_space_type"

A <<express:mesh_topology_schema.mesh_maths_space_type,mesh_maths_space_type>> is an enumeration of the kinds of associations of a <<express:mesh_topology_schema.mesh_derived_maths_space,mesh_derived_maths_space>> and a <<express:mesh_topology_schema.mesh,mesh>>.

*)

(*"mesh_topology_schema.mesh_maths_space_type.cells"

data is associated with mesh cells;

*)

(*"mesh_topology_schema.mesh_maths_space_type.vertices"

data is associated with mesh vertices.

*)

(*"mesh_topology_schema.structured_mesh_type"

A <<express:mesh_topology_schema.structured_mesh_type,structured_mesh_type>> is an enumeration of the kinds of structured meshes.

*)

(*"mesh_topology_schema.structured_mesh_type.rectangular"

a structured mesh that is topologically linear in 1-D, quadrilateral in 2-D, hexahedral in 3-D, etc.

In 2-D the cells are all quadrilateral. In 3-D the cells are all hexahedral.

NOTE: Illustrations of rectangular mesh topologies are shown in <<figure-mesh_topology_schema-fig4>>, <<figure-mesh_topology_schema-fig5>> and <<figure-mesh_topology_schema-fig6>>.

*)

(*"mesh_topology_schema.structured_mesh_type.pentahedral"

a structured mesh that is topologically linear in 1-D, triangular in 2-D, and pentahedral, with 2 triangular and 3 quadrilateral faces forming a wedge-like shape, in 3-D. (where one of the edges between a pair of rectangular faces is analogous to the axis of a sector of a cylinder).

It is convenient to think of this kind of mesh as like a sector of a circle in 2-D where one apex point is anolagous to the centre point of the circle, and like a sector of a cylinder in 3-D where one of the edges between a pair of rectangular faces is analogous to the axis of the cylinder.

In 2-D the cells adjacent to the apex are triangular; the rest are quadrilateral.

In 3-D the cells adjacent to the axis edge are pentahedral; the rest are hexahedral.

NOTE: Illustrations of pentahedral mesh topologies are shown in <<figure-mesh_topology_schema-fig4>>, <<figure-mesh_topology_schema-fig7>> and <<figure-mesh_topology_schema-fig8>>.

*)

(*"mesh_topology_schema.structured_mesh_type.pyramidal"

a structured mesh that is topologically linear in 1-D, triangular in 2-D, and pyramidal in 3-D.


It is convenient to think of this kind of mesh as like a sector of a circle in 2-D where one apex point is analogous to the centre point of the circle, and like a sector of a sphere in 3-D where the apex point is analogous to the centre point of a sector of the sphere.

In 2-D the cells adjacent to the apex are triangular; the rest are quadrilateral.

In 3-D the cells adjacent to the apex are pyrimidal; the rest are hexahedral.

NOTE: Illustrations of pyramidal mesh topologies are shown in <<figure-mesh_topology_schema-fig4>>, <<figure-mesh_topology_schema-fig7>> and <<figure-mesh_topology_schema-fig9>>.

*)

(*"mesh_topology_schema.structured_mesh_type.tetrahedral"

a structured mesh that is topologically linear in 1-D, triangular in 2-D, and tetrahedral in 3-D.

It is convenient to think of this kind of mesh as like a sector of a circle in 2-D where one apex point is analagous to the centre point of the circle, and like

In 2-D the cells adjacent to the apex are triangular; the remainder are quadrilateral.

In 3-D the cells adjacent to the apex are tetrahedral and the cells adjacent to one edge from the apex are pentahedral; the remainder are hexahedral.

NOTE: Illustrations of tetrahedral mesh topologies are shown in <<figure-mesh_topology_schema-fig4>>, <<figure-mesh_topology_schema-fig7>> and <<figure-mesh_topology_schema-fig10>>.


[[figure-mesh_topology_schema-fig4]]
.A 1-D rectangular_mesh or pentahedral_mesh or pyramidal_mesh or tetrahedral_mesh (with stem:[i = 5])
image::images/fig04.svg[]

[[figure-mesh_topology_schema-fig5]]
.A 2-D rectangular_mesh (with stem:[i = 5, j = 4])
image::images/fig05.svg[]

[[figure-mesh_topology_schema-fig6]]
.A 3-D rectangular_mesh (with stem:[i = 5, j = 4, k = 3])
image::images/fig06.svg[]

[[figure-mesh_topology_schema-fig7]]
.A 2-D pentahedral_mesh or pyramidal_mesh or tetrahedral_mesh (with stem:[i = 5, j = 4])
image::images/fig07.svg[]

[[figure-mesh_topology_schema-fig8]]
.A 3-D pentahedral_mesh (with stem:[i = 5, j = 4, k = 3])
image::images/fig08.svg[]

[[figure-mesh_topology_schema-fig9]]
.A 3-D pyramidal_mesh (with stem:[i = 5, j = 4, k = 3])
image::images/fig09.svg[]

[[figure-mesh_topology_schema-fig10]]
.A 3-D tetrahedral_mesh (with stem:[i = 5, j = 4, k = 3])
image::images/fig10.svg[]

*)

(*"mesh_topology_schema.array_based_unstructured_mesh"

An *array_based_structured_mesh* is a representation of an <<express:mesh_topology_schema.unstructured_mesh,unstructured_mesh>> designed to minimise the amount of data by not requiring explicit identification of the vertices of the cells in the mesh.

*)

(*"mesh_topology_schema.array_based_unstructured_mesh.cells"

the *vertex_defined_cells* forming the mesh.

*)

(*"mesh_topology_schema.array_based_unstructured_mesh.cell_count"

(inherited) the number of cells in the mesh;

*)

(*"mesh_topology_schema.array_based_unstructured_mesh.index_count"

(inherited) the number of indices required to uniquely identify a vertex or cell in the mesh.

*)

(*"mesh_topology_schema.array_based_unstructured_mesh.wr1"

the value of *index_count* shall be 1.

*)

(*"mesh_topology_schema.array_based_unstructured_mesh_and_vertices"

An *array_based_structured_mesh_and_vertices* is a kind of <<express:mesh_topology_schema.array_based_unstructured_mesh,array_based_unstructured_mesh>> where the vertices of the mesh are explicity identified and ordered.

*)

(*"mesh_topology_schema.array_based_unstructured_mesh_and_vertices.vertex_count"

the number of unique <<express:topology_schema.vertex,vertex>> in the mesh;

*)

(*"mesh_topology_schema.array_based_unstructured_mesh_and_vertices.vertices"

an array of unique *vertexs* for the cells of the mesh.

*)

(*"mesh_topology_schema.array_based_unstructured_mesh_and_vertices.wr1"

the elements of *vertices* shall be all and only the unique vertices in the mesh.

*)

(*"mesh_topology_schema.cell"

A cell is a <<express:topology_schema.topological_representation_item,topological_representation_item>> that is a manifold with a boundary.

*)

(*"mesh_topology_schema.cell.description"

annotation;

*)

(*"mesh_topology_schema.cell.dimension"

the topological dimension of the region.

*)

(*"mesh_topology_schema.cell_with_explicit_boundary"

A <<express:mesh_topology_schema.cell_with_explicit_boundary,cell_with_explicit_boundary>> is a <<express:mesh_topology_schema.cell,cell>> that has a specified boundary.

*)

(*"mesh_topology_schema.cell_with_explicit_boundary.boundary"

the elements forming the boundary of the region.

*)

(*"mesh_topology_schema.cell_of_structured_mesh"

A <<express:mesh_topology_schema.cell_of_structured_mesh,cell_of_structured_mesh>> is an identified cell of a <<express:mesh_topology_schema.structured_mesh,structured_mesh>>.

*)

(*"mesh_topology_schema.cell_of_structured_mesh.the_mesh"

the <<express:mesh_topology_schema.structured_mesh,structured_mesh>>;

*)

(*"mesh_topology_schema.cell_of_structured_mesh.cell_identifier"

the indices of the cell;

*)

(*"mesh_topology_schema.cell_of_structured_mesh.index_count"

the number of indices required to uniquely identify a vertex or cell in the mesh;

*)

(*"mesh_topology_schema.explicit_unstructured_mesh"

An <<express:mesh_topology_schema.explicit_unstructured_mesh,explicit_unstructured_mesh>> is a representation of an <<express:mesh_topology_schema.unstructured_mesh,unstructured_mesh>> that is similar, but not entirely identical to, that specified in ISO 10303-104.

*)

(*"mesh_topology_schema.explicit_unstructured_mesh.explicit_model"

the finite element model;

*)

(*"mesh_topology_schema.explicit_unstructured_mesh.cell_count"

(inherited) the number of <<express:structural_response_representation_schema.element_representation,element_representations>>;

*)

(*"mesh_topology_schema.explicit_unstructured_mesh.cells"

the set of <<express:structural_response_representation_schema.element_representation,element_representations>> comprising the mesh.

*)

(*"mesh_topology_schema.explicit_unstructured_mesh.ip1"

every <<express:structural_response_representation_schema.element_representation,element_representation>> in the *cells* shall belong to the *explicit_model*.

*)

(*"mesh_topology_schema.extraction_of_structured_submesh"

An <<express:mesh_topology_schema.extraction_of_structured_submesh,extraction_of_structured_submesh>> is a type of *extraction_of_mesh* and is a relationship between two *structured_meshes* that indicates one is part of the other.

*)

(*"mesh_topology_schema.extraction_of_structured_submesh.part"

the <<express:mesh_topology_schema.structured_mesh,structured_mesh>> that is part of the *whole*;

*)

(*"mesh_topology_schema.extraction_of_structured_submesh.whole"

the <<express:mesh_topology_schema.structured_mesh,structured_mesh>> that contains the *part*;

*)

(*"mesh_topology_schema.extraction_of_structured_submesh.lower_vertex"

the position of the <<express:topology_schema.vertex,vertex>> in the *whole* that is the origin of the *part*. This is specified with respect to each index of the *whole*.

*)

(*"mesh_topology_schema.extraction_of_structured_submesh.used_indices"

the indices of the *whole* that are also indices of the *part* in the order that they are used in the *part*;

*)

(*"mesh_topology_schema.extraction_of_structured_submesh.used_senses"

the sense for each index of *part* as:

* TRUE if the *part* uses the index of the *whole* in the same direction;
* FALSE if the *part* uses the index of the *whole* in the reverse direction;

*)

(*"mesh_topology_schema.extraction_of_structured_submesh.whole_indices"

the number of indices required to uniquely identify a vertex or cell in the *whole*;

*)

(*"mesh_topology_schema.extraction_of_structured_submesh.part_indices"

the number of indices required to uniquely identify a vertex or cell in the *part*;

*)

(*"mesh_topology_schema.extraction_of_structured_submesh.wr:WR1"

The mesh referenced as *whole* shall be of type <<express:mesh_topology_schema.structured_mesh,structured_mesh>>.

*)

(*"mesh_topology_schema.extraction_of_structured_submesh.wr:WR2"

The submesh referenced as *part* shall be of type <<express:mesh_topology_schema.structured_mesh,structured_mesh>>.

*)

(*"mesh_topology_schema.extraction_of_submesh"

An *extracrtion_of_submesh* is a relationship between a <<express:mesh_topology_schema.mesh,mesh>> and a <<express:mesh_topology_schema.submesh,submesh>> that defines the <<express:mesh_topology_schema.submesh,submesh>> as being part of the <<express:mesh_topology_schema.mesh,mesh>>.

*)

(*"mesh_topology_schema.extraction_of_submesh.whole"

the <<express:mesh_topology_schema.mesh,mesh>> from which the <<express:mesh_topology_schema.submesh,submesh>> is extracted.

*)

(*"mesh_topology_schema.extraction_of_submesh.part"

the resulting <<express:mesh_topology_schema.submesh,submesh>>.

*)

(*"mesh_topology_schema.extraction_of_submesh_by_cells"

An <<express:mesh_topology_schema.extraction_of_submesh_by_cells,extraction_of_submesh_by_cells>> is a type of <<express:mesh_topology_schema.extraction_of_submesh,extraction_of_submesh>> that extracts a submesh by listing the cells.

*)

(*"mesh_topology_schema.extraction_of_submesh_by_cells.cell_count"

the number of cells extracted to form the submesh.

*)

(*"mesh_topology_schema.extraction_of_submesh_by_cells.cells"

the collection of *cells* defining the <<express:mesh_topology_schema.submesh,submesh>>.

*)

(*"mesh_topology_schema.extraction_of_submesh_by_vertices"

An <<express:mesh_topology_schema.extraction_of_submesh_by_vertices,extraction_of_submesh_by_vertices>> is a type of <<express:mesh_topology_schema.extraction_of_submesh,extraction_of_submesh>> that extracts a submesh by listing the vertices.

NOTE: A submesh of lower topological dimension than the parent (whole) mesh can be specified by *extraction_of_mesh_by_vertices*.

*)

(*"mesh_topology_schema.extraction_of_submesh_by_vertices.vertex_count"

the number of vertices extracted to form the submesh.

*)

(*"mesh_topology_schema.extraction_of_submesh_by_vertices.vertices"

the collection of *vertexs* defining the <<express:mesh_topology_schema.submesh,submesh>>.

*)

(*"mesh_topology_schema.indices_list"

An <<express:mesh_topology_schema.indices_list,indices_list>> specifies a list of indices into a multi-dimensional array.

*)

(*"mesh_topology_schema.indices_list.nindices"

the number of indices required to map to a unique array location;

*)

(*"mesh_topology_schema.indices_list.indices"

the indices.

*)

(*"mesh_topology_schema.indices_range"

An <<express:mesh_topology_schema.indices_range,indices_range>> specifies the beginning and ending indices of a subrange in a multi-dimensional array.

*)

(*"mesh_topology_schema.indices_range.nindices"

the number of indices required to map to a unique array location;

*)

(*"mesh_topology_schema.indices_range.start"

the indices of the minimal corner of the subrange;

*)

(*"mesh_topology_schema.indices_range.finish"

the indices of the maximal corner of the subrange.

*)

(*"mesh_topology_schema.mesh"

A <<express:mesh_topology_schema.mesh,mesh>> is a <<express:topology_schema.topological_representation_item,topological_representation_item>> consisting of one or more cells. The <<express:mesh_topology_schema.mesh,mesh>> is the basis of all mesh topology representations. There are several ways of representing a mesh.

*)

(*"mesh_topology_schema.mesh.description"

annotation;

*)

(*"mesh_topology_schema.mesh.index_count"

the number of indices required to identify uniquely a vertex or cell in the mesh.

NOTE: It inherits a *name* attribute of type <<express:support_resource_schema.label,label>> via its <<express:topology_schema.topological_representation_item,topological_representation_item>> supertype.

*)

(*"mesh_topology_schema.mesh_derived_maths_space"

A <<express:mesh_topology_schema.mesh_derived_maths_space,mesh_derived_maths_space>> associates data values and a <<express:mesh_topology_schema.mesh,mesh>>.

NOTE: The association commences with the <<express:mathematical_description_of_distribution_schema.property_distribution_description,property_distribution_description>> entity whose *abstract_function* attribute is of type *math_function* (a table function in this case) whose *range* and *domain* are of type <<express:mathematical_functions_schema.maths_space,maths_space>>, and hence to a <<express:mesh_topology_schema.mesh,mesh>>.

*)

(*"mesh_topology_schema.mesh_derived_maths_space.description"

annotation;

*)

(*"mesh_topology_schema.mesh_derived_maths_space.name"

a user interpretable identifier;

*)

(*"mesh_topology_schema.mesh_derived_maths_space.id"

an identifier;

*)

(*"mesh_topology_schema.mesh_derived_maths_space.the_mesh"

the <<express:mesh_topology_schema.mesh,mesh>>;

*)

(*"mesh_topology_schema.mesh_derived_maths_space.kind"

the kind of association.

*)

(*"mesh_topology_schema.product_of_mesh"

A <<express:mesh_topology_schema.product_of_mesh,product_of_mesh>> is a relationship that is between:

* two operands that are a 1-dimensional <<express:mesh_topology_schema.mesh,mesh>> and an stem:[n]-dimensional <<express:mesh_topology_schema.mesh,mesh>>; and

* a product that is an stem:[(n + 1)]-dimensional <<express:mesh_topology_schema.mesh,mesh>>,

that indicates the stem:[(n + 1)]-dimensional <<express:mesh_topology_schema.mesh,mesh>> is the Cartesian product of the operands.

The ordering of cells and vertices of the product <<express:mesh_topology_schema.mesh,mesh>> is:

* cell stem:[i + n(j - 1)] of the product mesh corresponds to cell stem:[i] of the first operand and cell stem:[j] of the second operand, where stem:[n] is the total number of cells of the first operand;

* vertex stem:[i + m(j - 1)] of the product mesh corresponds to vertex stem:[i] of the first operand and vertex stem:[j] of the second operand, where stem:[m] is the total number of vertices of the first operand.

*)

(*"mesh_topology_schema.product_of_mesh.operands"

the two *meshes* that define the *product*;

*)

(*"mesh_topology_schema.product_of_mesh.product"

the <<express:mesh_topology_schema.mesh,mesh>> that is the Cartesian product of the *operands*.

*)

(*"mesh_topology_schema.product_of_mesh.wr:WR1"

all meshes shall be *structured_meshes*;

*)

(*"mesh_topology_schema.product_of_mesh.wr:WR2"

the first operand shall have an *index_count* of one;

*)

(*"mesh_topology_schema.product_of_mesh.wr:WR3"

the *index_count* of the *product* shall equal the sum of the *index_counts* of the *operands*.

*)

(*"mesh_topology_schema.rind"

A <<express:mesh_topology_schema.rind,rind>> describes the number of rind planes associated with a structured mesh.

*)

(*"mesh_topology_schema.rind.index_count"

the number of indices required to reference a vertex;

*)

(*"mesh_topology_schema.rind.planes"

contains the number of rind planes attached to the minimum and maximum faces of a structured mesh. The face corresponding to each index stem:[n] of *planes* in 3-D is:

stem:[n = 1 -> i_{min}] stem:[n = 2 -> i_{max}]

stem:[n = 3 -> j_{min}] stem:[n = 4 -> j_{max}]

stem:[n = 5 -> k_{min}] stem:[n = 6 -> k_{max}]

[example]
====
For a 3-D mesh whose 'core' size is stem:[II xx JJ xx KK], a value of *planes* stem:[= [a,b,c,d,e,f\]] indicates that the range of indices for the mesh with this rind is:

[stem]
++++
i: (1 - a, II + b)
++++

[stem]
++++
j: (1 - c, JJ + d)
++++

[stem]
++++
k: (1 - e, KK + f)
++++
====

*)

(*"mesh_topology_schema.structured_mesh"

A <<express:mesh_topology_schema.structured_mesh,structured_mesh>> has a regular topology. A <<express:mesh_topology_schema.structured_mesh,structured_mesh>> has a parametric coordinate system; the parametric coordinate systems for one- two-, and three-dimensional structured meshes are shown in <<figure-mesh_topology_schema-fig11>> through <<figure-mesh_topology_schema-fig13>>.

[[figure-mesh_topology_schema-fig11]]
.Parametric coordinate system for a 1-D structured mesh
image::images/fig11.svg[]

[[figure-mesh_topology_schema-fig12]]
.Parametric coordinate system for a 2-D structured mesh
image::images/fig12.svg[]

[[figure-mesh_topology_schema-fig13]]
.Parametric coordinate system for a 3-D structured mesh
image::images/fig13.svg[]

For each cell within a <<express:mesh_topology_schema.structured_mesh,structured_mesh>>, the parametric coordinate system for that cell is identical to the parametric coordinate system for the mesh, except for an origin shift. The parametric coordinates of vertex stem:[(i, j, k)] in a 3-D mesh with stem:[n, m] and stem:[p] cells in the 3 dimensions are:

[stem]
++++
((i - 1)/n, (j - 1)/m, (k - 1)/p)
++++

*)

(*"mesh_topology_schema.structured_mesh.vertex_counts"

the number of vertices in each dimension of the mesh. The product of the array elements is the number of vertices defining the mesh (i.e., excluding any rind points). The number of vertices in one- two- and three-dimensional regular mesh topologies is given in <<table1>>, where stem:[i], stem:[j] and stem:[k] correspond to the array elements vertex `vertex_counts[1]`, `vertex_counts[2]` and `vertex_counts[3]`, respectively.

*)

(*"mesh_topology_schema.structured_mesh.cell_counts"

the number of cells in each dimension of the mesh. The product of the array elements is the number of cells on the interior of the mesh;

*)

(*"mesh_topology_schema.structured_mesh.kind"

the kind of mesh;

*)

(*"mesh_topology_schema.structured_mesh.index_count"

(inherited) the number of indices required to identify uniquely a vertex or cell in the mesh is the same as the topological dimensionality (e.g., 1-D, 3-D) of the mesh.

[[table1]]
.Number of vertices in a structured_mesh
|===
| Index_count | Rectangular | Pentahedral | Pyramidal | Tetrahedral

| 1 | stem:[i] | stem:[i] | stem:[i] | stem:[i]
| 2 | stem:[ij] | stem:[j(i - 1) + 1] | stem:[j(i - 1) + 1] | stem:[j(i - 1) + 1]
| 3 | stem:[ijk] | stem:[jk(i - 1) + k] | stem:[jk(i - 1) + 1] | stem:[jk(i - 1) - (i - 2)(j - 1)]
|===

*)

(*"mesh_topology_schema.structured_mesh_with_rind"

A <<express:mesh_topology_schema.structured_mesh_with_rind,structured_mesh_with_rind>> is a <<express:mesh_topology_schema.structured_mesh,structured_mesh>> with specified <<express:mesh_topology_schema.rind,rind>> planes.

*)

(*"mesh_topology_schema.structured_mesh_with_rind.rind_planes"

the <<express:mesh_topology_schema.rind,rind>> planes associated with the mesh.

*)

(*"mesh_topology_schema.submesh"

A <<express:mesh_topology_schema.submesh,submesh>> is a <<express:mesh_topology_schema.mesh,mesh>> that is part of another <<express:mesh_topology_schema.mesh,mesh>>. The submesh is related to the parent <<express:mesh_topology_schema.mesh,mesh>> by an <<express:mesh_topology_schema.extraction_of_submesh,extraction_of_submesh>> relationship. The cells of the <<express:mesh_topology_schema.submesh,submesh>> are not necessarily connected.

*)

(*"mesh_topology_schema.unstructured_mesh"

An <<express:mesh_topology_schema.unstructured_mesh,unstructured_mesh>> is composed of cells, where the cells do not form a regular pattern and the shape of the cells is not uniform throughout the mesh. Cells have vertices at the ends of cell edges, and may also have nodes on cell edges, cell faces and in the interior of the cell.

It conceptually consists of the vertices of the mesh and the cells forming the volume of the mesh. The cells shall all be connected by each cell having at least one vertex in common with another cell. The shape of each cell in an unstructured mesh is explicitly specified.

NOTE: A vertex at the corner of a cell is a cell vertex.

*)

(*"mesh_topology_schema.unstructured_mesh.cell_count"

the number of cells in the mesh.

*)

(*"mesh_topology_schema.vertex_defined_cell"

A <<express:mesh_topology_schema.vertex_defined_cell,vertex_defined_cell>> is a cell that is defined by its vertices. The number of vertices depends on the topological shape of the cell. The cell may have edge, face and interior vertices. The maximum number of edge, face and interior vertices depends on both the shape and the order of the cell.

*)

(*"mesh_topology_schema.vertex_defined_cell.shape"

the topological shape of the cell;

*)

(*"mesh_topology_schema.vertex_defined_cell.order"

the order of the cell geometric interpolation;

*)

(*"mesh_topology_schema.vertex_defined_cell.vertices"

the vertices at the ends of cell edges, and within cell edges, cell faces and the interior of the cell. The position of a vertex or an edge node in the array depends on the shape of the cell as established graphically in Figures 10 through 39 in ISO 10303-104.

NOTE: For convenience, most of the ISO 10303-104 Figures have been redrawn in this document as <<figure-mesh_topology_schema-fig14>> to <<figure-mesh_topology_schema-fig20>>, where a vertex or edge node is indicated by a dot. The vertex labelled '1' is the first index in the array, that labelled '2' is the second index in the array, and so on. Edge and face information from ISO 10303-104 is given in <<table2>> to <<table4>>.

*)

(*"mesh_topology_schema.vertex_defined_cell.bound_count"

the number of cell bounding vertices; it is determined by the value of *shape*;

*)

(*"mesh_topology_schema.vertex_defined_cell.edge_node_count"

the number of interior cell nodes located on the cell edges; it is determined by the combination of the values of *shape* and *order*;

*)

(*"mesh_topology_schema.vertex_defined_cell.opt_node_count"

the potential number of interior cell nodes which are not located on the cell edges; it is determined by the combination of the values of *shape* and *order*;

NOTE: In <<figure-mesh_topology_schema-fig14>> to <<figure-mesh_topology_schema-fig20>> the non-edge interior nodes are indicated by circles.

*)

(*"mesh_topology_schema.vertex_defined_cell.required_count"

the total number of bounding vertices plus the number of edge nodes;

*)

(*"mesh_topology_schema.vertex_defined_cell.vn_count"

the total number of bounding vertices plus the number of nodes (both edge and non-dege nodes);

*)

(*"mesh_topology_schema.vertex_defined_cell.required_vertices"

the vertices and nodes excluding any non-edge interior nodes. There shall be *required_count* of these.

[[table2]]
.Edges of triangle and quadrilateral cells
[options=header,headerrows=2,cols=4]
|===
2+^| triangle 2+^| quadrilateral
^|edge ^|vertices ^|edge ^|vertices

^| 1 ^| 1, 2 ^| 1 ^| 1, 2
^| 2 ^| 2, 3 ^| 2 ^| 2, 3
^| 3 ^| 3, 1 ^| 3 ^| 3, 4
| | ^| 4 ^| 4, 1
|===

[[table3]]
.Edges of hexahedron, wedge, tetrahedron and pyramid cells
|===
2+^.^h| hexahedron 2+^.^h| wedge 2+^.^h| tetrahedron 2+^.^h| pyramid
^.^h| edge ^.^h| vertices ^.^h| edge ^.^h| vertices ^.^h| edge ^.^h| vertices ^.^h| edge ^.^h| vertices

^.^| 1 ^.^| 1, 2 ^.^| 1 ^.^| 1, 2 ^.^| 1 ^.^| 1, 2 ^.^| 1 ^.^| 1, 2
^.^| 2 ^.^| 2, 3 ^.^| 2 ^.^| 2, 3 ^.^| 2 ^.^| 2, 3 ^.^| 2 ^.^| 2, 3
^.^| 3 ^.^| 3, 4 ^.^| 3 ^.^| 3, 1 ^.^| 3 ^.^| 3, 1 ^.^| 3 ^.^| 3, 4
^.^| 4 ^.^| 4, 1 ^.^| 4 ^.^| 4, 5 ^.^| 4 ^.^| 1, 4 ^.^| 4 ^.^| 4, 1
^.^| 5 ^.^| 5, 6 ^.^| 5 ^.^| 5, 6 ^.^| 5 ^.^| 2, 4 ^.^| 5 ^.^| 1, 5
^.^| 6 ^.^| 6, 7 ^.^| 6 ^.^| 6, 4 ^.^| 6 ^.^| 3, 4 ^.^| 6 ^.^| 2, 5
^.^| 7 ^.^| 7, 8 ^.^| 7 ^.^| 1, 4 | | ^.^| 7 ^.^| 3, 5
^.^| 8 ^.^| 8, 5 ^.^| 8 ^.^| 2, 5 | | ^.^| 8 ^.^| 4, 5
^.^| 9 ^.^| 1, 5 ^.^| 9 ^.^| 3, 6 | | | |
^.^| 10 ^.^| 2, 6 | | | | | |
^.^| 11 ^.^| 3, 7 | | | | | |
^.^| 12 ^.^| 4, 8 | | | | | |
|===

[[table4]]
.Faces of hexahedron, wedge, tetrahedron and pyramid cells
|===
2+^.^h| hexahedron 2+^.^h| wedge 2+^.^h| tetrahedron 2+^.^h| pyramid
^.^h| face ^.^h| vertices ^.^h| face ^.^h| vertices ^.^h| face ^.^h| vertices ^.^h| face ^.^h| vertices

^.^| 1 ^.^| 1, 4, 3, 2 ^.^| 1 ^.^| 1, 3, 2 ^.^| 1 ^.^| 1, 2, 3 ^.^| 1 ^.^| 1, 4, 3, 2
^.^| 2 ^.^| 5, 6, 7, 8 ^.^| 2 ^.^| 4, 5, 6 ^.^| 2 ^.^| 1, 4, 2 ^.^| 2 ^.^| 1, 2, 5
^.^| 3 ^.^| 1, 2, 6, 5 ^.^| 3 ^.^| 1, 2, 4, 5 ^.^| 3 ^.^| 2, 4, 3 ^.^| 3 ^.^| 2, 3, 5
^.^| 4 ^.^| 3, 7, 6, 2 ^.^| 4 ^.^| 2, 3, 6, 5 ^.^| 4 ^.^| 3, 4, 1 ^.^| 4 ^.^| 3, 4, 5
^.^| 5 ^.^| 3, 4, 8, 7 ^.^| 5 ^.^| 1, 4, 6, 3 | | ^.^| 5 ^.^| 4, 1, 5
^.^| 6 ^.^| 1, 5, 8, 4 | | | | | |
|===


[[figure-mesh_topology_schema-fig14]]
.Linear, quadratic and cubic line cells
image::images/fig14.svg[]

[[figure-mesh_topology_schema-fig15]]
.Linear, quadratic and cubic triangle cells
image::images/fig15.svg[]

[[figure-mesh_topology_schema-fig16]]
.Linear, quadratic and cubic quadrilateral cells
image::images/fig16.svg[]

[[figure-mesh_topology_schema-fig17]]
.Linear, quadratic and cubic hexahedron cells
image::images/fig17.svg[]

[[figure-mesh_topology_schema-fig18]]
.Linear, quadratic and cubic wedge cells
image::images/fig18.svg[]

[[figure-mesh_topology_schema-fig19]]
.Linear, quadratic and cubic tetrahedron cells
image::images/fig19.svg[]

[[figure-mesh_topology_schema-fig20]]
.Linear, quadratic and cubic pyramid cells
image::images/fig20.svg[]

*)

(*"mesh_topology_schema.all_mesh_vertices"

The function <<express:mesh_topology_schema.all_mesh_vertices,all_mesh_vertices>> takes an <<express:mesh_topology_schema.array_based_unstructured_mesh_and_vertices,array_based_unstructured_mesh_and_vertices>> as its argument and returns TRUE if the members of the *vertices* attribute are exactly the vertices in the mesh.

*)

(*"mesh_topology_schema.all_mesh_vertices.arg"

an <<express:mesh_topology_schema.array_based_unstructured_mesh_and_vertices,array_based_unstructured_mesh_and_vertices>>;

*)

(*"mesh_topology_schema.all_mesh_vertices.RETURNS"

TRUE if the members of the *vertices* attribute of *arg* are exactly the vertices in the mesh, otherwise FALSE.

*)

(*"mesh_topology_schema.cell_counts"

The function <<express:mesh_topology_schema.cell_counts,cell_counts>> takes a <<express:mesh_topology_schema.vertex_defined_cell,vertex_defined_cell>> as its argument and returns the numbers of vertices and nodes required to define the cell.

*)

(*"mesh_topology_schema.cell_counts.arg"

a <<express:mesh_topology_schema.cell,cell>>;

*)

(*"mesh_topology_schema.cell_counts.RETURNS"

a 3 element array of INTEGER, where the first element is the number of vertices defining the bounds of the cell, the second is the number of interior nodes located on an edge, and the third is the maximum number of (potential) interior nodes not located on an edge.

*)

(*"mesh_topology_schema.shorten_array"

The function shorten_array inputs a one dimensional array and returns a shorter one dimensional array containing the first *newl* elements of the input array.

*)

(*"mesh_topology_schema.shorten_array.longa"

The input array.

*)

(*"mesh_topology_schema.shorten_array.oldl"

The number of elements in *longa*.

*)

(*"mesh_topology_schema.shorten_array.newl"

The smaller number of elements in the output array.

*)

(*"mesh_topology_schema.shorten_array.RETURN"

The shortened array of length *newl*

*)

