THIS SCHEMA HAS BEEN MODIFIED FROM THE SCHEMA DEFINED IN
ISO 10303-53 ed1 Numerical analysis - Analysis product relationships schema
AND SHOULD NOT BE INTERPRETED AS COMPLYING WITH THAT STANDARD
*)

SCHEMA analysis_product_relationships_schema '{iso standard 10303 part(53) version(1) object(1) analysis-product-relationships-schema(1)}';

  REFERENCE FROM analysis_schema -- ISO 10303-53
    (numerical_model);

  REFERENCE FROM product_analysis_schema -- ISO 10303-53
    (temporal_spatial_domain);

  REFERENCE FROM product_definition_schema -- ISO 10303-41
    (product_definition);

  REFERENCE FROM support_resource_schema -- ISO 10303-41
    (identifier,
     label,
     text);

ENTITY idealisation_relationship;
  id  : identifier;
  name : label;
  description : text;
  idealised : product_definition;
  idealisation : temporal_spatial_domain;
END_ENTITY;

ENTITY view_relationship;
  id : identifier;
  name :label;
  description : text;
  viewed : temporal_spatial_domain;
  view : numerical_model;
END_ENTITY;

END_SCHEMA; -- analysis_product_relationships_schema


(*"analysis_product_relationships_schema.__published_in"
ISO 10303-53:2011 ED1
*)

(*"analysis_product_relationships_schema.__status"
IS
*)

(*"analysis_product_relationships_schema.__title"
numerical_analysis
*)


(*"analysis_product_relationships_schema"
// Note schema EXPRESS are in ..\resources\resource_name name_of_schema.xml
This schema specifies relationships between the definitions of objects and analyses.
*)
(*"analysis_product_relationships_schema.__fund_cons"

The analysis_product_relationships_schema associates the concepts in the product_analysis_schema and analysis_schema with the product structure core specified in ISO 10303-41 providing a specification of the idealisation and analysis of the product.

// <fund_cons/>

// EXPRESS-G

*)
