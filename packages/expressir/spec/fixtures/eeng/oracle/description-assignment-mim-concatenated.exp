-- MATHEMATICAL_CONTEXT_SCHEMA (/Users/mulgogi/src/mn/iso-10303/schemas/resources/mathematical_context_schema/mathematical_context_schema.exp)
--
(*
ISO 10303 TC184/SC4/WG12 N3251

EXPRESS Source:
ISO 10303-51 ed1 Mathematical representation - Mathematical context schema

The following permission notice and disclaimer shall be included in all copies of this EXPRESS schema ("the Schema"),
and derivations of the Schema:

Copyright ISO 2014  All rights reserved
Permission is hereby granted, free of charge in perpetuity, to any person obtaining a copy of the Schema,
to use, copy, modify, merge and distribute free of charge, copies of the Schema for the purposes of developing,
implementing, installing and using software based on the Schema, and to permit persons to whom the Schema is furnished to do so,
subject to the following conditions:

THE SCHEMA IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,
INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.
IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM,
DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE,
ARISING FROM, OUT OF OR IN CONNECTION WITH THE SCHEMA OR THE
USE OR OTHER DEALINGS IN THE SCHEMA.

In addition, any modified copy of the Schema shall include the following notice:

THIS SCHEMA HAS BEEN MODIFIED FROM THE SCHEMA DEFINED IN
ISO 10303-51 ed1 Mathematical representation - Mathematical context schema
AND SHOULD NOT BE INTERPRETED AS COMPLYING WITH THAT STANDARD
*)

SCHEMA mathematical_context_schema '{iso standard 10303 part(51) version(1) object(1) mathematical-context-schema(1)}';

REFERENCE FROM action_schema   -- ISO 10303-41
  (action,
   action_method);

REFERENCE FROM mathematical_functions_schema   -- ISO 10303-50
  (maths_space,
   maths_value);

REFERENCE FROM measure_schema   -- ISO 10303-41
  (unit);

REFERENCE FROM product_definition_schema   -- ISO 10303-41
  (product_definition);

REFERENCE FROM product_property_definition_schema   -- ISO 10303-41
  (general_property,
   shape_aspect);

REFERENCE FROM representation_schema   -- ISO 10303-43
  (representation_context,
   representation_item);

REFERENCE FROM support_resource_schema   -- ISO 10303-41
  (identifier,
   label,
   text);

REFERENCE FROM iso13584_generic_expressions_schema   -- ISO 13584-20
  (generic_expression);


TYPE space_context_select = EXTENSIBLE SELECT
   (action,
    action_method,
    general_property,
    product_definition,
    representation_item,
    shape_aspect);
END_TYPE;

TYPE value_context_select = EXTENSIBLE SELECT
   (action,
    action_method,
    general_property,
    product_definition,
    representation_item,
    shape_aspect);
END_TYPE;

ENTITY compound_maths_space_context
  SUBTYPE OF (maths_space_context);
  components : LIST[2:?] OF maths_space_context;
END_ENTITY;

ENTITY defined_maths_space_context
  SUBTYPE OF (maths_space_context);
END_ENTITY;

ENTITY explicitly_enumerated_maths_space_context
  SUBTYPE OF (maths_space_context);
  members : SET[1:?] OF maths_value_context;
END_ENTITY;

ENTITY maths_space_context
  SUPERTYPE OF (ONEOF (compound_maths_space_context,
                       defined_maths_space_context,
                       explicitly_enumerated_maths_space_context));
  id : identifier;
  name : label;
  description : OPTIONAL text;
  abstract_space : maths_space;
  physical_space : space_context_select;
END_ENTITY;

ENTITY maths_value_context;
  id : identifier;
  name : label;
  description : OPTIONAL text;
  abstract_value : maths_value;
  physical_value : value_context_select;
END_ENTITY;

ENTITY membership_of_maths_space_context;
  space_context : maths_space_context;
  value_context : maths_value_context;
END_ENTITY;

ENTITY normalized_maths_space_context
  SUBTYPE OF (defined_maths_space_context);
  normalization_basis : value_context_select;
END_ENTITY;

ENTITY representation_context_defined_maths_space_context
  SUBTYPE OF (defined_maths_space_context);
  representation_basis : representation_context;
END_ENTITY;

ENTITY unit_defined_maths_space_context
  SUBTYPE OF (defined_maths_space_context);
  unit_basis : unit;
END_ENTITY;

END_SCHEMA;  -- mathematical_context_schema

(*"mathematical_context_schema.__published_in"
ISO 10303-51:2005 ED1
*)

(*"mathematical_context_schema.__status"
IS
*)

(*"mathematical_context_schema.__title"
mathematical_representation
*)


(*"mathematical_context_schema"
// Note schema EXPRESS are in ..\resources\resource_name name_of_schema.xml

The *mathematical_context_schema* specifies a mapping between a physical set or space and a mathematical space.

The physical set can be:

* a family of products;
* positions within a product;
* states within an activity or state space;
* physical quantity values within a physical quantity space.

The mapping defines an identification scheme for members of the physical set. A member of the physical set is identified by a mathematical value within the mathematical space.

[example]
====
The set cross sections along beam 'XB_1234' are identified by the set real values in the range [-1.0, +1.0].
====

[example]
====
The set of states during the activity that is 'normal start up of engine type XYZ_123' are identified by the set of real values in the range [0.0, 1.0].
====

[example]
====
The set of temperatures are identified by the set of real values greater that -273.15
====

*)
(*"mathematical_context_schema.__fund_cons"

A mapping between a physical set and a mathematical space is called a parameterisation if the physical set is:

* a family of products;
* positions within a product; or
* states within an activity or state space.

A parameterisation can be given a name. There are two ways of providing more information about a parameterisation, as follows:

the mathematical value can be specified for each member of the physical set (provided the physical set is finite); or

a property distribution can be described with respect to the parameterisation, as described in the mathematical description of distribution schema.

[example]
====
A parameterisation is defined for the set of cross sections within beam 'XB_1234'. A description of the positions of the cross-sections within the beam for its initial undeformed state provides information about the nature of the parameterisation.
====

[example]
====
A parameterisation is defined for the set of states within the activity that is 'normal start up of engine type XYZ_123'. A description of the times of the states within the start up activity provides information about the nature of the parameterisation.
====

A mapping between a physical quantity space and a mathematical space is called a scale. A scale can be:

* a standard scale defined by ISO or some other standardisation body, i.e by a unit of measure; or
* defined with respect to another scale by a transformation, such as a 3D coordinate transformation.

[NOTE]
--
This document references ISO 10303-43 'Integrated generic resources: Representation structures' for entities that define a scale.
--

[example]
====
The International Practical Temperature Scale 1968 (IPTS-68) is a mapping between the space of temperatures and the set of real numbers greater than -273.15.

The fixed points within the scale are degrees of hotness that are identified by particular physical phenomena, such as the freezing point of gold. For each fixed point, a real value is assigned.
====

// EXPRESS-G

*)
(*"mathematical_context_schema.__expressg"
[[mathematical_context_schema_expg1]]
[.svgmap]
====
image::mathematical_context_schemaexpg1.svg[]

* <<express:mathematical_context_schema>>; 1
====

*)
(*"mathematical_context_schema.__expressg"
[[mathematical_context_schema_expg2]]
[.svgmap]
====
image::mathematical_context_schemaexpg2.svg[]

* <<express:mathematical_context_schema.maths_space_context>>; 1
* <<express:mathematical_context_schema.maths_value_context>>; 2
* <<express:product_definition_schema.product_definition>>; 3
* <<express:action_schema.action>>; 4
* <<express:representation_schema.representation_item>>; 5
* <<express:mathematical_context_schema.value_context_select>>; 6
* <<express:product_property_definition_schema.shape_aspect>>; 7
* <<express:product_property_definition_schema.general_property>>; 8
* <<express:mathematical_context_schema.space_context_select>>; 9
====
*)

(*"mathematical_context_schema.compound_maths_space_context"
A **compound_maths_space_context** is a type of <<express:mathematical_context_schema.maths_space_context,maths_space_context>> that is defined by a list of other instances of <<express:mathematical_context_schema.maths_space_context,maths_space_context>>. The referenced <<express:mathematical_functions_schema.maths_space,maths_space>> is a space of tuples. The <<express:mathematical_context_schema.maths_space_context,maths_space_context>> for each item in a tuple has the corresponding position in the list.

stem:[P_1]: the relationship between the 2D set of points on the surface of 'my product' and stem:[RR^2]; and

stem:[P_2]:the relationship between the 1D set of states in 'my activity' and R.

The relationship between:

* the 3D set of set of points on the surface of 'my product' for the states in 'my activity', and
* stem:[RR^3],

is the **compound_maths_space_context** defined by P1 x P2.
*)

(*"mathematical_context_schema.compound_maths_space_context.__example"
Consider two different instances of <<express:mathematical_context_schema.maths_space_context,maths_space_context>>, as follows:
*)

(*"mathematical_context_schema.compound_maths_space_context.components"
the instances of <<express:mathematical_context_schema.maths_space_context,maths_space_context>> that are components of the **compound_maths_space_context**. A <<express:mathematical_context_schema.maths_space_context,maths_space_context>> for a single state of a product can be derived from the <<express:mathematical_context_schema.maths_space_context,maths_space_context>> of the product. In this case the single state shall have a **compound_maths_space_context** with a components list consisting of a single reference to the <<express:mathematical_context_schema.maths_space_context,maths_space_context>> of the product.
*)


(*"mathematical_context_schema.defined_maths_space_context"
A **defined_maths_space_context** is a type of <<express:mathematical_context_schema.maths_space_context,maths_space_context>> that is defined by reference to a <<express:representation_schema.representation_context,representation_context>>, <<express:measure_schema.unit,unit>> or both.
*)


(*"mathematical_context_schema.defined_maths_space_context.__note"
A *defined_maths_space_context* can be instantiated as a <<express:mathematical_context_schema.representation_context_defined_maths_space_context,representation_context_defined_maths_space_context>>, a <<express:mathematical_context_schema.unit_defined_maths_space_context,unit_defined_maths_space_context>> or both.
*)

(*"mathematical_context_schema.explicitly_enumerated_maths_space_context"
An **explicitly_enumerated_maths_space_context** is a type of <<express:mathematical_context_schema.maths_space_context,maths_space_context>> that is defined by specifying the instances of <<express:mathematical_context_schema.maths_value_context,maths_value_context>> that are members of the <<express:mathematical_context_schema.maths_space_context,maths_space_context>>.
*)


(*"mathematical_context_schema.explicitly_enumerated_maths_space_context.__note"
An *explicitly_enumerated_maths_space_context* can only be specified for a discrete <<express:mathematical_functions_schema.maths_space,maths_space>> with a finite number of members.
*)

(*"mathematical_context_schema.explicitly_enumerated_maths_space_context.members"
the instances of <<express:mathematical_context_schema.maths_value_context,maths_value_context>> that are members of the <<express:mathematical_context_schema.maths_space_context,maths_space_context>>.
*)


(*"mathematical_context_schema.maths_space_context"
A **maths_space_context** is a 1-1 mapping between a physical space and a <<express:mathematical_functions_schema.maths_space,maths_space>> that indicates a meaning for the <<express:mathematical_functions_schema.maths_space,maths_space>>.
*)


(*"mathematical_context_schema.maths_space_context.id"
the <<express:support_resource_schema.identifier,identifier>> for the <<express:mathematical_context_schema.maths_space_context,maths_space_context>>.
*)


(*"mathematical_context_schema.maths_space_context.name"
the <<express:support_resource_schema.label,label>> by which the **maths_space_context** is known.
*)


(*"mathematical_context_schema.maths_space_context.description"
the <<express:support_resource_schema.text,text>> that characterizes the **maths_space_context**. The value of this attribute need not be specified.
*)


(*"mathematical_context_schema.maths_space_context.abstract_space"
the <<express:mathematical_functions_schema.maths_space,maths_space>> that has each member corresponding to one member of the <<express:mathematical_context_schema.maths_space_context.physical_space,physical_space>>.
*)


(*"mathematical_context_schema.maths_space_context.abstract_space.__note"
This schema references the ABSTRACT entity type <<express:mathematical_functions_schema.maths_space,maths_space>> from ISO 10303-50, but not an entity type that is a SUBTYPE. An Application Module that uses this document should reference or define at least one SUBTYPE.
*)

(*"mathematical_context_schema.maths_space_context.abstract_space.__note"
Each of the subtypes of <<express:mathematical_functions_schema.maths_function,maths_function>> defined in ISO 10303-50 requires that a <<express:mathematical_functions_schema.maths_space,maths_space>> be a <<express:mathematical_functions_schema.tuple_space,tuple_space>>.
*)

(*"mathematical_context_schema.maths_space_context.physical_space"
the physical space that has each member corresponding to one members of the <<express:mathematical_context_schema.maths_space_context.abstract_space,abstract_space>>.
*)


(*"mathematical_context_schema.maths_value_context"
A **maths_value_context** is an association between a physical value and a <<express:mathematical_functions_schema.maths_space,maths_space>>. A meaning assigned to a <<express:mathematical_functions_schema.maths_value,maths_value>> by such an association can be deduced from a <<express:mathematical_context_schema.maths_space_context,maths_space_context>> that has the <<express:mathematical_context_schema.maths_value_context,maths_value_context>> as a member.
*)


(*"mathematical_context_schema.maths_value_context.id"
the <<express:support_resource_schema.identifier,identifier>> for the **maths_value_context**.
*)


(*"mathematical_context_schema.maths_value_context.name"
the <<express:support_resource_schema.label,label>> by which the **maths_value_context** is known.
*)


(*"mathematical_context_schema.maths_value_context.description"
the <<express:support_resource_schema.text,text>> that characterizes the **maths_value_context**. The value of this attribute need not be specified.
*)


(*"mathematical_context_schema.maths_value_context.abstract_value"
the <<express:mathematical_functions_schema.maths_value,maths_value>> that corresponds to the <<express:mathematical_context_schema.maths_value_context.physical_value,physical_value>>.
*)


(*"mathematical_context_schema.maths_value_context.physical_value"
the physical value that corresponds to the <<express:mathematical_functions_schema.maths_value,maths_value>>.
*)


(*"mathematical_context_schema.membership_of_maths_space_context"
A **membership_of_maths_space_context** is an association between a <<express:mathematical_context_schema.maths_value_context,maths_value_context>> and a <<express:mathematical_context_schema.maths_space_context,maths_space_context>> that indicates the <<express:mathematical_context_schema.maths_value_context,maths_value_context>> is a member of the <<express:mathematical_context_schema.maths_space_context,maths_space_context>>.
*)


(*"mathematical_context_schema.membership_of_maths_space_context.space_context"
the <<express:mathematical_context_schema.maths_space_context,maths_space_context>> that has the <<express:mathematical_context_schema.maths_value_context,maths_value_context>> as a member.
*)


(*"mathematical_context_schema.membership_of_maths_space_context.value_context"
the <<express:mathematical_context_schema.maths_value_context,maths_value_context>> that is a member of the <<express:mathematical_context_schema.maths_space_context,maths_space_context>>.
*)


(*"mathematical_context_schema.normalized_maths_space_context"
A **normalized_maths_space_context** is a type of <<express:mathematical_context_schema.defined_maths_space_context,defined_maths_space_context>> that is defined by a reference physical value.

Let:

stem:[p] be a physical value;

stem:[p_0] be the reference physical value;

stem:[v] be the maths value.

An instance of **normalized_maths_space_context** specifies that:

stem:[p = p_0 * v]
*)


(*"mathematical_context_schema.normalized_maths_space_context.normalization_basis"
the reference physical value that defines the <<express:mathematical_context_schema.maths_space_context,maths_space_context>>.
*)


(*"mathematical_context_schema.representation_context_defined_maths_space_context"
A **representation_context_defined_maths_space_context** is a type of <<express:mathematical_context_schema.defined_maths_space_context,defined_maths_space_context>> that specifies a coordinate system. It is defined by reference to a <<express:representation_schema.representation_context,representation_context>>.
*)


(*"mathematical_context_schema.representation_context_defined_maths_space_context.representation_basis"
the <<express:representation_schema.representation_context,representation_context>> that defines the <<express:mathematical_context_schema.maths_space_context,maths_space_context>>.
*)


(*"mathematical_context_schema.unit_defined_maths_space_context"
A **unit_defined_maths_space_context** is a type of <<express:mathematical_context_schema.defined_maths_space_context,defined_maths_space_context>> that is defined by a single unit of measure.
*)


(*"mathematical_context_schema.unit_defined_maths_space_context.unit_basis"
the unit that defines the <<express:mathematical_context_schema.maths_space_context,maths_space_context>>.
*)


(*"mathematical_context_schema.unit_defined_maths_space_context.unit_basis.__note"
This schema references the SELECT type unit from ISO 10303-41, but not the entity types that are selected by unit. An Application Module that uses this document should reference at least one of these entity types.
*)

(*"mathematical_context_schema.__schema_file"
data/resource_docs/mathematical_representation/resource.xml
*)


