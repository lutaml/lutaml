* <<express:product_property_definition_schema.general_property>>; 3
* <<express:support_resource_schema.text>>; 4
* <<express:support_resource_schema.text>>; 5
* <<express:support_resource_schema.text>>; 6
* <<express:support_resource_schema.text>>; 7
* <<express:support_resource_schema.text>>; 8
* <<express:support_resource_schema.text>>; 9
* <<express:support_resource_schema.identifier>>; 10
* <<express:support_resource_schema.identifier>>; 11
