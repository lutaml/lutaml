see ISO 1000;
*)


(*"measure_schema.si_prefix.femto"
see ISO 1000;
*)


(*"measure_schema.si_prefix.atto"
see ISO 1000.
*)


(*"measure_schema.si_unit_name"
An **si_unit_name** is the name of an SI unit.
*)


(*"measure_schema.si_unit_name.__note"
The definitions of the names of SI units are specified in ISO 1000.
*)

(*"measure_schema.si_unit_name.metre"
see ISO 1000;
*)


(*"measure_schema.si_unit_name.gram"
see ISO 1000;
*)


(*"measure_schema.si_unit_name.gram.__note"
ISO 1000 gives "kilogram" as the SI unit name. This document uses "gram" as the SI unit name.
*)

(*"measure_schema.si_unit_name.second"
see ISO 1000;
*)


(*"measure_schema.si_unit_name.ampere"
see ISO 1000;
*)


(*"measure_schema.si_unit_name.kelvin"
see ISO 1000;
*)


(*"measure_schema.si_unit_name.mole"
see ISO 1000;
*)


(*"measure_schema.si_unit_name.candela"
see ISO 1000;
*)


(*"measure_schema.si_unit_name.radian"
see ISO 1000;
*)


(*"measure_schema.si_unit_name.steradian"
see ISO 1000;
*)


(*"measure_schema.si_unit_name.hertz"
see ISO 1000;
*)


(*"measure_schema.si_unit_name.newton"
see ISO 1000;
*)


(*"measure_schema.si_unit_name.pascal"
see ISO 1000;
*)


(*"measure_schema.si_unit_name.joule"
see ISO 1000;
*)


(*"measure_schema.si_unit_name.watt"
see ISO 1000;
*)


(*"measure_schema.si_unit_name.coulomb"
see ISO 1000;
*)


(*"measure_schema.si_unit_name.volt"
see ISO 1000;
*)


(*"measure_schema.si_unit_name.farad"
see ISO 1000;
*)


(*"measure_schema.si_unit_name.ohm"
see ISO 1000;
*)


(*"measure_schema.si_unit_name.siemens"
see ISO 1000;
*)


