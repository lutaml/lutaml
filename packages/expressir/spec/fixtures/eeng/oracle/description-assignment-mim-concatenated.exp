* <<express:scan_data_3d_shape_model_schema.point_cloud_dataset_with_normals>>; 11
* <<express:scan_data_3d_shape_model_schema.point_cloud_dataset_with_intensities>>; 12
* <<express:scan_data_3d_shape_model_schema.scanner_property>>; 13
