NUMBER / express_keywords.tNVL / express_keywords.tODD / express_keywords.tOF / express_keywords.tONEOF / express_keywords.tOPTIONAL / express_keywords.tOR / express_keywords.tOTHERWISE / express_keywords.tPI / express_keywords.tPROCEDURE / express_keywords.tQUERY / express_keywords.tREAL / express_keywords.tREFERENCE / express_keywords.tREMOVE / express_keywords.tRENAMED / express_keywords.tREPEAT / express_keywords.tRETURN / express_keywords.tROLESOF / express_keywords.tRULE / express_keywords.tSCHEMA / express_keywords.tSELECT / express_keywords.tSELF / express_keywords.tSET / express_keywords.tSIN / express_keywords.tSIZEOF / express_keywords.tSKIP / express_keywords.tSQRT / express_keywords.tSTRING / express_keywords.tSUBTYPE / express_keywords.tSUBTYPE_CONSTRAINT / express_keywords.tSUPERTYPE / express_keywords.tTAN / express_keywords.tTHEN / express_keywords.tTO / express_keywords.tTRUE / express_keywords.tTYPE / express_keywords.tTYPEOF / express_keywords.tTOTAL_OVER / express_keywords.tUNIQUE / express_keywords.tUNKNOWN / express_keywords.tUNTIL / express_keywords.tUSE / express_keywords.tUSEDIN / express_keywords.tVALUE / express_keywords.tVALUE_IN / express_keywords.tVALUE_UNIQUE / express_keywords.tVAR / express_keywords.tWITH / express_keywords.tWHERE / express_keywords.tWHILE / express_keywords.tXOR
  digit = %x30-39
  atomic digits = digit 0* digit
  atomic simpleId = !(anyKeyword) (express_remarks.spaces (((%x41-5A / %x61-7A / %x5F) 0* (%x30-39 / %x41-5A / %x61-7A / %x5F))) as str) as simpleId
  simpleStringLiteral = (express_remarks.spaces ("'" 0* (!("'") %x01-10FFFF) "'") as str) as simpleStringLiteral
  atomic unguardedId = (express_remarks.spaces (((%x41-5A / %x61-7A / %x5F) 0* (%x30-39 / %x41-5A / %x61-7A / %x5F))) as str) as simpleId
