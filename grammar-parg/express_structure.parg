# EXPRESS structural statements — first vertical slice. Each rule is
# translated from lib/expressir/express/grammar/parser.rb; the corpus
# diff loop arbitrates tree shapes as bodies land.
use express_keywords

use express_operators

grammar ExpressStructure version "0.1.0" edition 2 {
  # (tSKIP >> op_delim).as(:skipStmt)
  skipStmt = (express_keywords.tSKIP express_operators.op_delim) as skipStmt
}
