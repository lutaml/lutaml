# EXPRESS grammar — PARG edition 2 (skeleton).
#
# The translation of lib/expressir/express/grammar/parser.rb, rule by
# rule; see CONVENTIONS.md for the mapping and the parity-critical
# surfaces. This skeleton carries the trivia machinery only: it compiles
# and self-checks, proving the toolchain loop while the 252-rule body
# translation proceeds in RULE-INVENTORY.txt order.
grammar ExpressSyntax version "0.1.0" edition 2 {

  # match[" \r\n\t\f"].repeat(1)
  trivia = 1*(%x20 / %x0D / %x0A / %x09 / %x0C)

  # The DSL's skip(:trivia, whitespace: :space, exempt: ...) — the
  # exempted rules become `atomic` declarations as they land; the
  # remark rules stay OUT of the skip surface (they are product data).
  skip = trivia capture: space

  # Placeholder entry: whitespace-only acceptance, until the rule body
  # translation fills in (each landed rule replaces this line's
  # dependencies, never the header or the skip declaration).
  syntax = *trivia

# --- keyword terminals (generated by generate-terminals.rb; do not
#     hand-edit — rerun the script instead) ---
# The trailing-identifier guard: a keyword must not be followed by
# a letter, digit, or underscore (the DSL's match[a-zA-Z0-9_].absent?).
identGuard = !(%x41-5A / %x61-7A / %x30-39 / "_")
tABS = ((("A" / "a") ("B" / "b") ("S" / "s") identGuard) as str) as tABS
tABSTRACT = ((("A" / "a") ("B" / "b") ("S" / "s") ("T" / "t") ("R" / "r") ("A" / "a") ("C" / "c") ("T" / "t") identGuard) as str) as tABSTRACT
tACOS = ((("A" / "a") ("C" / "c") ("O" / "o") ("S" / "s") identGuard) as str) as tACOS
tAGGREGATE = ((("A" / "a") ("G" / "g") ("G" / "g") ("R" / "r") ("E" / "e") ("G" / "g") ("A" / "a") ("T" / "t") ("E" / "e") identGuard) as str) as tAGGREGATE
tALIAS = ((("A" / "a") ("L" / "l") ("I" / "i") ("A" / "a") ("S" / "s") identGuard) as str) as tALIAS
tAND = ((("A" / "a") ("N" / "n") ("D" / "d") identGuard) as str) as tAND
tANDOR = ((("A" / "a") ("N" / "n") ("D" / "d") ("O" / "o") ("R" / "r") identGuard) as str) as tANDOR
tARRAY = ((("A" / "a") ("R" / "r") ("R" / "r") ("A" / "a") ("Y" / "y") identGuard) as str) as tARRAY
tAS = ((("A" / "a") ("S" / "s") identGuard) as str) as tAS
tASIN = ((("A" / "a") ("S" / "s") ("I" / "i") ("N" / "n") identGuard) as str) as tASIN
tATAN = ((("A" / "a") ("T" / "t") ("A" / "a") ("N" / "n") identGuard) as str) as tATAN
tBAG = ((("B" / "b") ("A" / "a") ("G" / "g") identGuard) as str) as tBAG
tBASED_ON = ((("B" / "b") ("A" / "a") ("S" / "s") ("E" / "e") ("D" / "d") "_" ("O" / "o") ("N" / "n") identGuard) as str) as tBASED_ON
tBEGIN = ((("B" / "b") ("E" / "e") ("G" / "g") ("I" / "i") ("N" / "n") identGuard) as str) as tBEGIN
tBINARY = ((("B" / "b") ("I" / "i") ("N" / "n") ("A" / "a") ("R" / "r") ("Y" / "y") identGuard) as str) as tBINARY
tBLENGTH = ((("B" / "b") ("L" / "l") ("E" / "e") ("N" / "n") ("G" / "g") ("T" / "t") ("H" / "h") identGuard) as str) as tBLENGTH
tBOOLEAN = ((("B" / "b") ("O" / "o") ("O" / "o") ("L" / "l") ("E" / "e") ("A" / "a") ("N" / "n") identGuard) as str) as tBOOLEAN
tBY = ((("B" / "b") ("Y" / "y") identGuard) as str) as tBY
tCASE = ((("C" / "c") ("A" / "a") ("S" / "s") ("E" / "e") identGuard) as str) as tCASE
tCONSTANT = ((("C" / "c") ("O" / "o") ("N" / "n") ("S" / "s") ("T" / "t") ("A" / "a") ("N" / "n") ("T" / "t") identGuard) as str) as tCONSTANT
tCONST_E = ((("C" / "c") ("O" / "o") ("N" / "n") ("S" / "s") ("T" / "t") "_" ("E" / "e") identGuard) as str) as tCONST_E
tCOS = ((("C" / "c") ("O" / "o") ("S" / "s") identGuard) as str) as tCOS
tDERIVE = ((("D" / "d") ("E" / "e") ("R" / "r") ("I" / "i") ("V" / "v") ("E" / "e") identGuard) as str) as tDERIVE
tDIV = ((("D" / "d") ("I" / "i") ("V" / "v") identGuard) as str) as tDIV
tELSE = ((("E" / "e") ("L" / "l") ("S" / "s") ("E" / "e") identGuard) as str) as tELSE
tEND = ((("E" / "e") ("N" / "n") ("D" / "d") identGuard) as str) as tEND
tEND_ALIAS = ((("E" / "e") ("N" / "n") ("D" / "d") "_" ("A" / "a") ("L" / "l") ("I" / "i") ("A" / "a") ("S" / "s") identGuard) as str) as tEND_ALIAS
tEND_CASE = ((("E" / "e") ("N" / "n") ("D" / "d") "_" ("C" / "c") ("A" / "a") ("S" / "s") ("E" / "e") identGuard) as str) as tEND_CASE
tEND_CONSTANT = ((("E" / "e") ("N" / "n") ("D" / "d") "_" ("C" / "c") ("O" / "o") ("N" / "n") ("S" / "s") ("T" / "t") ("A" / "a") ("N" / "n") ("T" / "t") identGuard) as str) as tEND_CONSTANT
tEND_ENTITY = ((("E" / "e") ("N" / "n") ("D" / "d") "_" ("E" / "e") ("N" / "n") ("T" / "t") ("I" / "i") ("T" / "t") ("Y" / "y") identGuard) as str) as tEND_ENTITY
tEND_FUNCTION = ((("E" / "e") ("N" / "n") ("D" / "d") "_" ("F" / "f") ("U" / "u") ("N" / "n") ("C" / "c") ("T" / "t") ("I" / "i") ("O" / "o") ("N" / "n") identGuard) as str) as tEND_FUNCTION
tEND_IF = ((("E" / "e") ("N" / "n") ("D" / "d") "_" ("I" / "i") ("F" / "f") identGuard) as str) as tEND_IF
tEND_LOCAL = ((("E" / "e") ("N" / "n") ("D" / "d") "_" ("L" / "l") ("O" / "o") ("C" / "c") ("A" / "a") ("L" / "l") identGuard) as str) as tEND_LOCAL
tEND_PROCEDURE = ((("E" / "e") ("N" / "n") ("D" / "d") "_" ("P" / "p") ("R" / "r") ("O" / "o") ("C" / "c") ("E" / "e") ("D" / "d") ("U" / "u") ("R" / "r") ("E" / "e") identGuard) as str) as tEND_PROCEDURE
tEND_REPEAT = ((("E" / "e") ("N" / "n") ("D" / "d") "_" ("R" / "r") ("E" / "e") ("P" / "p") ("E" / "e") ("A" / "a") ("T" / "t") identGuard) as str) as tEND_REPEAT
tEND_RULE = ((("E" / "e") ("N" / "n") ("D" / "d") "_" ("R" / "r") ("U" / "u") ("L" / "l") ("E" / "e") identGuard) as str) as tEND_RULE
tEND_SCHEMA = ((("E" / "e") ("N" / "n") ("D" / "d") "_" ("S" / "s") ("C" / "c") ("H" / "h") ("E" / "e") ("M" / "m") ("A" / "a") identGuard) as str) as tEND_SCHEMA
tEND_SUBTYPE_CONSTRAINT = ((("E" / "e") ("N" / "n") ("D" / "d") "_" ("S" / "s") ("U" / "u") ("B" / "b") ("T" / "t") ("Y" / "y") ("P" / "p") ("E" / "e") "_" ("C" / "c") ("O" / "o") ("N" / "n") ("S" / "s") ("T" / "t") ("R" / "r") ("A" / "a") ("I" / "i") ("N" / "n") ("T" / "t") identGuard) as str) as tEND_SUBTYPE_CONSTRAINT
tEND_TYPE = ((("E" / "e") ("N" / "n") ("D" / "d") "_" ("T" / "t") ("Y" / "y") ("P" / "p") ("E" / "e") identGuard) as str) as tEND_TYPE
tENTITY = ((("E" / "e") ("N" / "n") ("T" / "t") ("I" / "i") ("T" / "t") ("Y" / "y") identGuard) as str) as tENTITY
tENUMERATION = ((("E" / "e") ("N" / "n") ("U" / "u") ("M" / "m") ("E" / "e") ("R" / "r") ("A" / "a") ("T" / "t") ("I" / "i") ("O" / "o") ("N" / "n") identGuard) as str) as tENUMERATION
tESCAPE = ((("E" / "e") ("S" / "s") ("C" / "c") ("A" / "a") ("P" / "p") ("E" / "e") identGuard) as str) as tESCAPE
tEXISTS = ((("E" / "e") ("X" / "x") ("I" / "i") ("S" / "s") ("T" / "t") ("S" / "s") identGuard) as str) as tEXISTS
tEXP = ((("E" / "e") ("X" / "x") ("P" / "p") identGuard) as str) as tEXP
tEXTENSIBLE = ((("E" / "e") ("X" / "x") ("T" / "t") ("E" / "e") ("N" / "n") ("S" / "s") ("I" / "i") ("B" / "b") ("L" / "l") ("E" / "e") identGuard) as str) as tEXTENSIBLE
tFALSE = ((("F" / "f") ("A" / "a") ("L" / "l") ("S" / "s") ("E" / "e") identGuard) as str) as tFALSE
tFIXED = ((("F" / "f") ("I" / "i") ("X" / "x") ("E" / "e") ("D" / "d") identGuard) as str) as tFIXED
tFOR = ((("F" / "f") ("O" / "o") ("R" / "r") identGuard) as str) as tFOR
tFORMAT = ((("F" / "f") ("O" / "o") ("R" / "r") ("M" / "m") ("A" / "a") ("T" / "t") identGuard) as str) as tFORMAT
tFROM = ((("F" / "f") ("R" / "r") ("O" / "o") ("M" / "m") identGuard) as str) as tFROM
tFUNCTION = ((("F" / "f") ("U" / "u") ("N" / "n") ("C" / "c") ("T" / "t") ("I" / "i") ("O" / "o") ("N" / "n") identGuard) as str) as tFUNCTION
tGENERIC_ENTITY = ((("G" / "g") ("E" / "e") ("N" / "n") ("E" / "e") ("R" / "r") ("I" / "i") ("C" / "c") "_" ("E" / "e") ("N" / "n") ("T" / "t") ("I" / "i") ("T" / "t") ("Y" / "y") identGuard) as str) as tGENERIC_ENTITY
tGENERIC = ((("G" / "g") ("E" / "e") ("N" / "n") ("E" / "e") ("R" / "r") ("I" / "i") ("C" / "c") identGuard) as str) as tGENERIC
tHIBOUND = ((("H" / "h") ("I" / "i") ("B" / "b") ("O" / "o") ("U" / "u") ("N" / "n") ("D" / "d") identGuard) as str) as tHIBOUND
tHIINDEX = ((("H" / "h") ("I" / "i") ("I" / "i") ("N" / "n") ("D" / "d") ("E" / "e") ("X" / "x") identGuard) as str) as tHIINDEX
tIF = ((("I" / "i") ("F" / "f") identGuard) as str) as tIF
tIN = ((("I" / "i") ("N" / "n") identGuard) as str) as tIN
tINSERT = ((("I" / "i") ("N" / "n") ("S" / "s") ("E" / "e") ("R" / "r") ("T" / "t") identGuard) as str) as tINSERT
tINTEGER = ((("I" / "i") ("N" / "n") ("T" / "t") ("E" / "e") ("G" / "g") ("E" / "e") ("R" / "r") identGuard) as str) as tINTEGER
tINVERSE = ((("I" / "i") ("N" / "n") ("V" / "v") ("E" / "e") ("R" / "r") ("S" / "s") ("E" / "e") identGuard) as str) as tINVERSE
tLENGTH = ((("L" / "l") ("E" / "e") ("N" / "n") ("G" / "g") ("T" / "t") ("H" / "h") identGuard) as str) as tLENGTH
tLIKE = ((("L" / "l") ("I" / "i") ("K" / "k") ("E" / "e") identGuard) as str) as tLIKE
tLIST = ((("L" / "l") ("I" / "i") ("S" / "s") ("T" / "t") identGuard) as str) as tLIST
tLOBOUND = ((("L" / "l") ("O" / "o") ("B" / "b") ("O" / "o") ("U" / "u") ("N" / "n") ("D" / "d") identGuard) as str) as tLOBOUND
tLOCAL = ((("L" / "l") ("O" / "o") ("C" / "c") ("A" / "a") ("L" / "l") identGuard) as str) as tLOCAL
tLOG = ((("L" / "l") ("O" / "o") ("G" / "g") identGuard) as str) as tLOG
tLOG10 = ((("L" / "l") ("O" / "o") ("G" / "g") "1" "0" identGuard) as str) as tLOG10
tLOG2 = ((("L" / "l") ("O" / "o") ("G" / "g") "2" identGuard) as str) as tLOG2
tLOGICAL = ((("L" / "l") ("O" / "o") ("G" / "g") ("I" / "i") ("C" / "c") ("A" / "a") ("L" / "l") identGuard) as str) as tLOGICAL
tLOINDEX = ((("L" / "l") ("O" / "o") ("I" / "i") ("N" / "n") ("D" / "d") ("E" / "e") ("X" / "x") identGuard) as str) as tLOINDEX
tMOD = ((("M" / "m") ("O" / "o") ("D" / "d") identGuard) as str) as tMOD
tNOT = ((("N" / "n") ("O" / "o") ("T" / "t") identGuard) as str) as tNOT
tNUMBER = ((("N" / "n") ("U" / "u") ("M" / "m") ("B" / "b") ("E" / "e") ("R" / "r") identGuard) as str) as tNUMBER
tNVL = ((("N" / "n") ("V" / "v") ("L" / "l") identGuard) as str) as tNVL
tODD = ((("O" / "o") ("D" / "d") ("D" / "d") identGuard) as str) as tODD
tOF = ((("O" / "o") ("F" / "f") identGuard) as str) as tOF
tONEOF = ((("O" / "o") ("N" / "n") ("E" / "e") ("O" / "o") ("F" / "f") identGuard) as str) as tONEOF
tOPTIONAL = ((("O" / "o") ("P" / "p") ("T" / "t") ("I" / "i") ("O" / "o") ("N" / "n") ("A" / "a") ("L" / "l") identGuard) as str) as tOPTIONAL
tOR = ((("O" / "o") ("R" / "r") identGuard) as str) as tOR
tOTHERWISE = ((("O" / "o") ("T" / "t") ("H" / "h") ("E" / "e") ("R" / "r") ("W" / "w") ("I" / "i") ("S" / "s") ("E" / "e") identGuard) as str) as tOTHERWISE
tPI = ((("P" / "p") ("I" / "i") identGuard) as str) as tPI
tPROCEDURE = ((("P" / "p") ("R" / "r") ("O" / "o") ("C" / "c") ("E" / "e") ("D" / "d") ("U" / "u") ("R" / "r") ("E" / "e") identGuard) as str) as tPROCEDURE
tQUERY = ((("Q" / "q") ("U" / "u") ("E" / "e") ("R" / "r") ("Y" / "y") identGuard) as str) as tQUERY
tREAL = ((("R" / "r") ("E" / "e") ("A" / "a") ("L" / "l") identGuard) as str) as tREAL
tREFERENCE = ((("R" / "r") ("E" / "e") ("F" / "f") ("E" / "e") ("R" / "r") ("E" / "e") ("N" / "n") ("C" / "c") ("E" / "e") identGuard) as str) as tREFERENCE
tREMOVE = ((("R" / "r") ("E" / "e") ("M" / "m") ("O" / "o") ("V" / "v") ("E" / "e") identGuard) as str) as tREMOVE
tRENAMED = ((("R" / "r") ("E" / "e") ("N" / "n") ("A" / "a") ("M" / "m") ("E" / "e") ("D" / "d") identGuard) as str) as tRENAMED
tREPEAT = ((("R" / "r") ("E" / "e") ("P" / "p") ("E" / "e") ("A" / "a") ("T" / "t") identGuard) as str) as tREPEAT
tRETURN = ((("R" / "r") ("E" / "e") ("T" / "t") ("U" / "u") ("R" / "r") ("N" / "n") identGuard) as str) as tRETURN
tROLESOF = ((("R" / "r") ("O" / "o") ("L" / "l") ("E" / "e") ("S" / "s") ("O" / "o") ("F" / "f") identGuard) as str) as tROLESOF
tRULE = ((("R" / "r") ("U" / "u") ("L" / "l") ("E" / "e") identGuard) as str) as tRULE
tSCHEMA = ((("S" / "s") ("C" / "c") ("H" / "h") ("E" / "e") ("M" / "m") ("A" / "a") identGuard) as str) as tSCHEMA
tSELECT = ((("S" / "s") ("E" / "e") ("L" / "l") ("E" / "e") ("C" / "c") ("T" / "t") identGuard) as str) as tSELECT
tSELF = ((("S" / "s") ("E" / "e") ("L" / "l") ("F" / "f") identGuard) as str) as tSELF
tSET = ((("S" / "s") ("E" / "e") ("T" / "t") identGuard) as str) as tSET
tSIN = ((("S" / "s") ("I" / "i") ("N" / "n") identGuard) as str) as tSIN
tSIZEOF = ((("S" / "s") ("I" / "i") ("Z" / "z") ("E" / "e") ("O" / "o") ("F" / "f") identGuard) as str) as tSIZEOF
tSKIP = ((("S" / "s") ("K" / "k") ("I" / "i") ("P" / "p") identGuard) as str) as tSKIP
tSQRT = ((("S" / "s") ("Q" / "q") ("R" / "r") ("T" / "t") identGuard) as str) as tSQRT
tSTRING = ((("S" / "s") ("T" / "t") ("R" / "r") ("I" / "i") ("N" / "n") ("G" / "g") identGuard) as str) as tSTRING
tSUBTYPE = ((("S" / "s") ("U" / "u") ("B" / "b") ("T" / "t") ("Y" / "y") ("P" / "p") ("E" / "e") identGuard) as str) as tSUBTYPE
tSUBTYPE_CONSTRAINT = ((("S" / "s") ("U" / "u") ("B" / "b") ("T" / "t") ("Y" / "y") ("P" / "p") ("E" / "e") "_" ("C" / "c") ("O" / "o") ("N" / "n") ("S" / "s") ("T" / "t") ("R" / "r") ("A" / "a") ("I" / "i") ("N" / "n") ("T" / "t") identGuard) as str) as tSUBTYPE_CONSTRAINT
tSUPERTYPE = ((("S" / "s") ("U" / "u") ("P" / "p") ("E" / "e") ("R" / "r") ("T" / "t") ("Y" / "y") ("P" / "p") ("E" / "e") identGuard) as str) as tSUPERTYPE
tTAN = ((("T" / "t") ("A" / "a") ("N" / "n") identGuard) as str) as tTAN
tTHEN = ((("T" / "t") ("H" / "h") ("E" / "e") ("N" / "n") identGuard) as str) as tTHEN
tTO = ((("T" / "t") ("O" / "o") identGuard) as str) as tTO
tTRUE = ((("T" / "t") ("R" / "r") ("U" / "u") ("E" / "e") identGuard) as str) as tTRUE
tTYPE = ((("T" / "t") ("Y" / "y") ("P" / "p") ("E" / "e") identGuard) as str) as tTYPE
tTYPEOF = ((("T" / "t") ("Y" / "y") ("P" / "p") ("E" / "e") ("O" / "o") ("F" / "f") identGuard) as str) as tTYPEOF
tTOTAL_OVER = ((("T" / "t") ("O" / "o") ("T" / "t") ("A" / "a") ("L" / "l") "_" ("O" / "o") ("V" / "v") ("E" / "e") ("R" / "r") identGuard) as str) as tTOTAL_OVER
tUNIQUE = ((("U" / "u") ("N" / "n") ("I" / "i") ("Q" / "q") ("U" / "u") ("E" / "e") identGuard) as str) as tUNIQUE
tUNKNOWN = ((("U" / "u") ("N" / "n") ("K" / "k") ("N" / "n") ("O" / "o") ("W" / "w") ("N" / "n") identGuard) as str) as tUNKNOWN
tUNTIL = ((("U" / "u") ("N" / "n") ("T" / "t") ("I" / "i") ("L" / "l") identGuard) as str) as tUNTIL
tUSE = ((("U" / "u") ("S" / "s") ("E" / "e") identGuard) as str) as tUSE
tUSEDIN = ((("U" / "u") ("S" / "s") ("E" / "e") ("D" / "d") ("I" / "i") ("N" / "n") identGuard) as str) as tUSEDIN
tVALUE = ((("V" / "v") ("A" / "a") ("L" / "l") ("U" / "u") ("E" / "e") identGuard) as str) as tVALUE
tVALUE_IN = ((("V" / "v") ("A" / "a") ("L" / "l") ("U" / "u") ("E" / "e") "_" ("I" / "i") ("N" / "n") identGuard) as str) as tVALUE_IN
tVALUE_UNIQUE = ((("V" / "v") ("A" / "a") ("L" / "l") ("U" / "u") ("E" / "e") "_" ("U" / "u") ("N" / "n") ("I" / "i") ("Q" / "q") ("U" / "u") ("E" / "e") identGuard) as str) as tVALUE_UNIQUE
tVAR = ((("V" / "v") ("A" / "a") ("R" / "r") identGuard) as str) as tVAR
tWITH = ((("W" / "w") ("I" / "i") ("T" / "t") ("H" / "h") identGuard) as str) as tWITH
tWHERE = ((("W" / "w") ("H" / "h") ("E" / "e") ("R" / "r") ("E" / "e") identGuard) as str) as tWHERE
tWHILE = ((("W" / "w") ("H" / "h") ("I" / "i") ("L" / "l") ("E" / "e") identGuard) as str) as tWHILE
tXOR = ((("X" / "x") ("O" / "o") ("R" / "r") identGuard) as str) as tXOR

kwAny = tABS / tABSTRACT / tACOS / tAGGREGATE / tALIAS / tAND / tANDOR / tARRAY / tAS / tASIN / tATAN / tBAG / tBASED_ON / tBEGIN / tBINARY / tBLENGTH / tBOOLEAN / tBY / tCASE / tCONSTANT / tCONST_E / tCOS / tDERIVE / tDIV / tELSE / tEND / tEND_ALIAS / tEND_CASE / tEND_CONSTANT / tEND_ENTITY / tEND_FUNCTION / tEND_IF / tEND_LOCAL / tEND_PROCEDURE / tEND_REPEAT / tEND_RULE / tEND_SCHEMA / tEND_SUBTYPE_CONSTRAINT / tEND_TYPE / tENTITY / tENUMERATION / tESCAPE / tEXISTS / tEXP / tEXTENSIBLE / tFALSE / tFIXED / tFOR / tFORMAT / tFROM / tFUNCTION / tGENERIC_ENTITY / tGENERIC / tHIBOUND / tHIINDEX / tIF / tIN / tINSERT / tINTEGER / tINVERSE / tLENGTH / tLIKE / tLIST / tLOBOUND / tLOCAL / tLOG / tLOG10 / tLOG2 / tLOGICAL / tLOINDEX / tMOD / tNOT / tNUMBER / tNVL / tODD / tOF / tONEOF / tOPTIONAL / tOR / tOTHERWISE / tPI / tPROCEDURE / tQUERY / tREAL / tREFERENCE / tREMOVE / tRENAMED / tREPEAT / tRETURN / tROLESOF / tRULE / tSCHEMA / tSELECT / tSELF / tSET / tSIN / tSIZEOF / tSKIP / tSQRT / tSTRING / tSUBTYPE / tSUBTYPE_CONSTRAINT / tSUPERTYPE / tTAN / tTHEN / tTO / tTRUE / tTYPE / tTYPEOF / tTOTAL_OVER / tUNIQUE / tUNKNOWN / tUNTIL / tUSE / tUSEDIN / tVALUE / tVALUE_IN / tVALUE_UNIQUE / tVAR / tWITH / tWHERE / tWHILE / tXOR
  # --- literal terminals (hand-translated) ---
  digit = %x30-39
  digits = 1*%x30-39
  # One quantified class run (parsanol GH-69: a single Re consumes the
  # whole identifier in one step), guarded against every keyword.
  simpleId = (!kwAny ((%x41-5A / %x61-7A / "_") *(%x41-5A / %x61-7A / %x30-39 / "_")) as str) as simpleId
  simpleStringLiteral = ("'" (*(!"'" %x01-10FFFF)) "'") as simpleStringLiteral
  octet = (%x30-39 / %x41-46 / %x61-66) (%x30-39 / %x41-46 / %x61-66)
  encodedStringLiteral = ("'" octet octet octet octet "'") as encodedStringLiteral
  # --- operator terminals (cstr(lit).as(name); trivia rides the skip) ---
  op_asterisk = ("*" as str) as op_asterisk
  op_colon = (":" as str) as op_colon
  op_colon_equals_colon = (":=:" as str) as op_colon_equals_colon
  op_colon_less_greater_colon = (":<>:" as str) as op_colon_less_greater_colon
  op_comma = ("," as str) as op_comma
  op_decl = (":=" as str) as op_decl
  op_delim = (";" as str) as op_delim
  op_double_asterisk = ("**" as str) as op_double_asterisk
  op_double_backslash = (%x5C as str) as op_double_backslash
  op_double_pipe = ("||" as str) as op_double_pipe
  op_equals = ("=" as str) as op_equals
  op_greater_equal = (">=" as str) as op_greater_equal
  op_greater_than = (">" as str) as op_greater_than
  op_leftbracket = ("[" as str) as op_leftbracket
  op_left_curly_brace = ("{" as str) as op_left_curly_brace
  op_leftparen = ("(" as str) as op_leftparen
  op_less_equal = ("<=" as str) as op_less_equal
  op_less_greater = ("<>" as str) as op_less_greater
  op_less_than = ("<" as str) as op_less_than
  op_minus = ("-" as str) as op_minus
  op_period = ("." as str) as op_period
  op_pipe = ("|" as str) as op_pipe
  op_plus = ("+" as str) as op_plus
  op_query_begin = ("<*" as str) as op_query_begin
  op_query_end = ("*>" as str) as op_query_end
  op_question_mark = ("?" as str) as op_question_mark
  op_rightbracket = ("]" as str) as op_rightbracket
  op_right_curly_brace = ("}" as str) as op_right_curly_brace
  op_rightparen = (")" as str) as op_rightparen
  op_slash = ("/" as str) as op_slash
  # ordered-union the DSL builds for the operators where alternatives
  # appear: longest-first at every alternation site that references them
  # (op_colon_equals_colon / op_colon etc.) — the sites keep the DSL order.
  # --- probe entries (mid-migration; the final entry is `syntax`) ---
  entry simpleId: simpleId
  entry simpleStringLiteral: simpleStringLiteral
  entry digits: digits
  entry op_decl: op_decl
  entry op_colon_less_greater_colon: op_colon_less_greater_colon
  entry tSCHEMA: tSCHEMA
  entry tBASED_ON: tBASED_ON
  entry tGENERIC_ENTITY: tGENERIC_ENTITY
  entry tEND_SUBTYPE_CONSTRAINT: tEND_SUBTYPE_CONSTRAINT
  entry syntax: syntax
}
