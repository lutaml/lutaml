# EXPRESS remark terminals: product data, NOT trivia. RemarkScanner
# attaches tail remarks backward; the DSL's shapes are preserved exactly
# (including the (*) empty-remark tolerance, issue #126).
grammar ExpressRemarks version "0.1.0" edition 2 {
  # (*): the 3-character empty embedded remark — opener and closer share
  # the star (technically invalid per ISO 10303-11 §7.1.6; accepted for
  # robustness). Otherwise (* ... *) with nesting.
  embeddedRemark = {
    (
      "(*)"
      / ("(*" (*(!("*)") (embeddedRemark / %x01-10FFFF)) "*)"))
    ) as embeddedRemark
  }

  # -- to end of line; the newline is optional at EOF.
  tailRemark = {
    ("--" (*(!("%x0A") %x01-10FFFF)) [("%x0A")]) as tailRemark
  }
}
