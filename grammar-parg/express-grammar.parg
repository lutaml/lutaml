# The structural grammar proper. The leaf vocabularies compose
# via top-level use declarations:
use express_keywords
use express_operators
use express_remarks
use express_literals

grammar ExpressSyntax version "0.1.0" edition 2 {
  # The DSL's trivia channel (match[" \r\n\t\f"].repeat(1)) is
  # emitted below from the live rule; remarks stay product data.
  abstractEntityDeclaration = (express_keywords.tABSTRACT) as abstractEntityDeclaration
  abstractSupertype = ((express_keywords.tABSTRACT express_keywords.tSUPERTYPE express_operators.op_delim) / (express_keywords.tABSTRACT express_operators.op_delim)) as abstractSupertype
  abstractSupertypeDeclaration = (express_keywords.tABSTRACT express_keywords.tSUPERTYPE [ subtypeConstraint ]) as abstractSupertypeDeclaration
  actualParameterList = (express_operators.op_leftparen [ ((parameter 0* (express_operators.op_comma parameter)) as listOf_parameter) ] express_operators.op_rightparen) as actualParameterList
  aggregateInitializer = (op_leftbracket [ ((element 0* (express_operators.op_comma element)) as listOf_element) ] op_rightbracket) as aggregateInitializer
  aggregateSource = (simpleExpression) as aggregateSource
  aggregateType = (express_keywords.tAGGREGATE [ (express_operators.op_colon typeLabel) ] express_keywords.tOF parameterType) as aggregateType
  aggregationTypes = (arrayType / bagType / listType / setType) as aggregationTypes
  algorithmHead = ((0* declaration) as declaration [ constantDecl ] [ localDecl ]) as algorithmHead
  aliasStmt = (express_keywords.tALIAS variableId express_keywords.tFOR generalRef (0* qualifier) as qualifier express_operators.op_delim (1* stmt) as stmt express_keywords.tEND_ALIAS (express_operators.op_delim) as op_delim2) as aliasStmt
  arrayType = (express_keywords.tARRAY boundSpec express_keywords.tOF [ express_keywords.tOPTIONAL ] [ express_keywords.tUNIQUE ] instantiableType) as arrayType
  assignmentStmt = (generalRef (0* qualifier) as qualifier express_operators.op_decl expression express_operators.op_delim) as assignmentStmt
  attributeDecl = (redeclaredAttribute / (express_literals.simpleId / express_literals.unguardedId) as attributeId) as attributeDecl
  attributeId = (express_literals.simpleId) as attributeId
  attributeQualifier = (op_period attributeRef) as attributeQualifier
  attributeRef = (attributeId) as attributeRef
  bagType = (express_keywords.tBAG [ boundSpec ] express_keywords.tOF instantiableType) as bagType
  binaryLiteral = (express_remarks.spaces ("%" 1* bit) as str) as binaryLiteral
  binaryType = (express_keywords.tBINARY [ widthSpec ]) as binaryType
  bit = %x30-31
  booleanType = (express_keywords.tBOOLEAN) as booleanType
  bound1 = (numericExpression) as bound1
  bound2 = (numericExpression) as bound2
  boundSpec = (op_leftbracket bound1 express_operators.op_colon bound2 op_rightbracket) as boundSpec
  builtInConstant = (express_keywords.tCONST_E / express_keywords.tPI / express_keywords.tSELF / op_question_mark) as builtInConstant
  builtInFunction = (express_keywords.tABS / express_keywords.tACOS / express_keywords.tASIN / express_keywords.tATAN / express_keywords.tBLENGTH / express_keywords.tCOS / express_keywords.tEXISTS / express_keywords.tEXP / express_keywords.tFORMAT / express_keywords.tHIBOUND / express_keywords.tHIINDEX / express_keywords.tLENGTH / express_keywords.tLOBOUND / express_keywords.tLOINDEX / express_keywords.tLOG2 / express_keywords.tLOG10 / express_keywords.tLOG / express_keywords.tNVL / express_keywords.tODD / express_keywords.tROLESOF / express_keywords.tSIN / express_keywords.tSIZEOF / express_keywords.tSQRT / express_keywords.tTAN / express_keywords.tTYPEOF / express_keywords.tUSEDIN / express_keywords.tVALUE_IN / express_keywords.tVALUE_UNIQUE / express_keywords.tVALUE) as builtInFunction
  builtInProcedure = (express_keywords.tINSERT / express_keywords.tREMOVE) as builtInProcedure
  caseAction = ((caseLabel 0* (express_operators.op_comma caseLabel)) as listOf_caseLabel express_operators.op_colon stmt) as caseAction
  caseLabel = (expression) as caseLabel
  caseStmt = (express_keywords.tCASE selector express_keywords.tOF (0* caseAction) as caseAction [ (express_keywords.tOTHERWISE express_operators.op_colon stmt) ] express_keywords.tEND_CASE express_operators.op_delim) as caseStmt
  compoundStmt = (express_keywords.tBEGIN (1* stmt) as stmt express_keywords.tEND express_operators.op_delim) as compoundStmt
  concreteTypes = (aggregationTypes / simpleTypes / typeRef) as concreteTypes
  constantBody = (constantId express_operators.op_colon instantiableType express_operators.op_decl expression express_operators.op_delim) as constantBody
  constantDecl = (express_keywords.tCONSTANT (1* constantBody) as constantBody express_keywords.tEND_CONSTANT express_operators.op_delim) as constantDecl
  constantFactor = (builtInConstant / constantRef) as constantFactor
  constantId = (express_literals.simpleId) as constantId
  constantRef = (constantId) as constantRef
  constructedTypes = (enumerationType / selectType) as constructedTypes
  declaration = (entityDecl / functionDecl / procedureDecl / subtypeConstraintDecl / typeDecl) as declaration
  delim = express_remarks.spaces (";") as delim
  deriveClause = (express_keywords.tDERIVE (1* derivedAttr) as derivedAttr) as deriveClause
  derivedAttr = (attributeDecl express_operators.op_colon parameterType express_operators.op_decl expression express_operators.op_delim) as derivedAttr
  domainRule = ([ (ruleLabelId express_operators.op_colon) ] expression) as domainRule
  element = (expression [ (express_operators.op_colon repetition) ]) as element
  encodedCharacter = octet octet octet octet
  encodedStringLiteral = (express_remarks.spaces (%x22 1* encodedCharacter %x22) as str) as encodedStringLiteral
  entityBody = ((0* explicitAttr) as explicitAttr [ deriveClause ] [ inverseClause ] [ uniqueClause ] [ whereClause ]) as entityBody
  entityConstructor = (entityRef express_operators.op_leftparen [ ((expression 0* (express_operators.op_comma expression)) as listOf_expression) ] express_operators.op_rightparen) as entityConstructor
  entityDecl = (entityHead entityBody express_keywords.tEND_ENTITY express_operators.op_delim) as entityDecl
  entityHead = (express_keywords.tENTITY entityId subsuper [ entityHeaderTail ]) as entityHead
  entityHeaderTail = (0* express_remarks.space [ express_operators.op_delim ]) as entityHeaderTail
  entityId = (express_literals.simpleId) as entityId
  entityRef = (entityId) as entityRef
  enumerationExtension = (express_keywords.tBASED_ON typeRef [ (express_keywords.tWITH enumerationItems) ]) as enumerationExtension
  enumerationId = (express_literals.simpleId) as enumerationId
  enumerationItem = (enumerationId) as enumerationItem
  enumerationItems = (express_operators.op_leftparen (enumerationItem 0* (express_operators.op_comma enumerationItem)) as listOf_enumerationItem express_operators.op_rightparen) as enumerationItems
  enumerationRef = (enumerationId) as enumerationRef
  enumerationReference = ([ (typeRef op_period) ] enumerationRef) as enumerationReference
  enumerationType = ([ express_keywords.tEXTENSIBLE ] express_keywords.tENUMERATION [ ((express_keywords.tOF enumerationItems) / enumerationExtension) ]) as enumerationType
  escapeStmt = (express_keywords.tESCAPE express_operators.op_delim) as escapeStmt
  explicitAttr = ((attributeDecl 0* (express_operators.op_comma attributeDecl)) as listOf_attributeDecl express_operators.op_colon [ express_keywords.tOPTIONAL ] parameterType express_operators.op_delim) as explicitAttr
  expression = (simpleExpression [ (relOpExtended (simpleExpression) as rhs) ]) as expression
  factor = (simpleFactor [ (op_double_asterisk (simpleFactor) as rhs) ]) as factor
  formalParameter = ((parameterId 0* (express_operators.op_comma parameterId)) as listOf_parameterId express_operators.op_colon parameterType) as formalParameter
  functionCall = ((builtInFunction / functionRef) [ actualParameterList ]) as functionCall
  functionDecl = (functionHead algorithmHead (1* stmt) as stmt express_keywords.tEND_FUNCTION express_operators.op_delim) as functionDecl
  functionHead = (express_keywords.tFUNCTION functionId ([ (express_operators.op_leftparen [ ((formalParameter 0* (express_operators.op_delim formalParameter)) as listOf_formalParameter) ] express_operators.op_rightparen) ]) as function_head_parameter_group express_operators.op_colon parameterType (express_operators.op_delim) as op_delim2) as functionHead
  functionId = (express_literals.simpleId) as functionId
  functionRef = (functionId) as functionRef
  generalAggregationTypes = (generalArrayType / generalBagType / generalListType / generalSetType) as generalAggregationTypes
  generalArrayType = (express_keywords.tARRAY [ boundSpec ] express_keywords.tOF [ express_keywords.tOPTIONAL ] [ express_keywords.tUNIQUE ] parameterType) as generalArrayType
  generalBagType = (express_keywords.tBAG [ boundSpec ] express_keywords.tOF parameterType) as generalBagType
  generalListType = (express_keywords.tLIST [ boundSpec ] express_keywords.tOF [ express_keywords.tUNIQUE ] parameterType) as generalListType
  generalRef = (parameterRef / variableId) as generalRef
  generalSetType = (express_keywords.tSET [ boundSpec ] express_keywords.tOF parameterType) as generalSetType
  generalizedTypes = (aggregateType / generalAggregationTypes / genericEntityType / genericType) as generalizedTypes
  genericEntityType = (express_keywords.tGENERIC_ENTITY [ (express_operators.op_colon typeLabel) ]) as genericEntityType
  genericType = (express_keywords.tGENERIC [ (express_operators.op_colon typeLabel) ]) as genericType
  groupQualifier = (op_double_backslash entityRef) as groupQualifier
  hexDigit = (%x30-39 / %x61-66 / %x41-46)
  ifStmt = (express_keywords.tIF logicalExpression express_keywords.tTHEN ifStmtStatements [ (express_keywords.tELSE ifStmtElseStatements) ] express_keywords.tEND_IF express_operators.op_delim) as ifStmt
  ifStmtElseStatements = ((1* stmt) as stmt) as ifStmtElseStatements
  ifStmtStatements = ((1* stmt) as stmt) as ifStmtStatements
  increment = (numericExpression) as increment
  incrementControl = (variableId express_operators.op_decl bound1 express_keywords.tTO bound2 [ (express_keywords.tBY increment) ]) as incrementControl
  index = (numericExpression) as index
  index1 = (index) as index1
  index2 = (index) as index2
  indexQualifier = (op_leftbracket index1 [ (express_operators.op_colon index2) ] op_rightbracket) as indexQualifier
  instantiableType = (concreteTypes / entityRef) as instantiableType
  integerLiteral = (express_remarks.spaces (express_literals.digits) as str) as integerLiteral
  integerType = (express_keywords.tINTEGER) as integerType
  interfaceSpecification = (referenceClause / useClause) as interfaceSpecification
  interval = (op_left_curly_brace intervalLow intervalOp intervalItem (intervalOp) as intervalOp2 intervalHigh op_right_curly_brace) as interval
  intervalHigh = (simpleExpression) as intervalHigh
  intervalItem = (simpleExpression) as intervalItem
  intervalLow = (simpleExpression) as intervalLow
  intervalOp = (express_operators.op_less_equal / express_operators.op_less_than) as intervalOp
  inverseAttr = (attributeDecl express_operators.op_colon inverseAttrType express_keywords.tFOR [ (entityRef op_period) ] attributeRef express_operators.op_delim) as inverseAttr
  inverseAttrType = ([ ((express_keywords.tSET / express_keywords.tBAG) [ boundSpec ] express_keywords.tOF) ] entityRef) as inverseAttrType
  inverseClause = (express_keywords.tINVERSE (1* inverseAttr) as inverseAttr) as inverseClause
  letter = (%x61-7A / %x41-5A)
  listType = (express_keywords.tLIST [ boundSpec ] express_keywords.tOF [ express_keywords.tUNIQUE ] instantiableType) as listType
  literal = (binaryLiteral / logicalLiteral / realLiteral / integerLiteral / stringLiteral) as literal
  localDecl = (express_keywords.tLOCAL (1* localVariable) as localVariable express_keywords.tEND_LOCAL express_operators.op_delim) as localDecl
  localVariable = ((variableId 0* (express_operators.op_comma variableId)) as listOf_variableId express_operators.op_colon parameterType [ (express_operators.op_decl expression) ] express_operators.op_delim) as localVariable
  logicalExpression = (expression) as logicalExpression
  logicalLiteral = (express_keywords.tFALSE / express_keywords.tTRUE / express_keywords.tUNKNOWN) as logicalLiteral
  logicalType = (express_keywords.tLOGICAL) as logicalType
  namedTypeOrRename = (namedTypes [ (express_keywords.tAS (entityId / typeId)) ]) as namedTypeOrRename
  namedTypes = (entityRef / typeRef) as namedTypes
  nullStmt = (express_operators.op_delim) as nullStmt
  numberType = (express_keywords.tNUMBER) as numberType
  numericExpression = (simpleExpression) as numericExpression
  octet = hexDigit hexDigit
  oneOf = (express_keywords.tONEOF express_operators.op_leftparen (supertypeExpression 0* (express_operators.op_comma supertypeExpression)) as listOf_supertypeExpression express_operators.op_rightparen) as oneOf
  op_double_asterisk = (express_remarks.spaces ("*" "*") as str) as op_double_asterisk
  op_double_backslash = (express_remarks.spaces (%x5C) as str) as op_double_backslash
  op_left_curly_brace = (express_remarks.spaces ("{") as str) as op_left_curly_brace
  op_leftbracket = (express_remarks.spaces ("[") as str) as op_leftbracket
  op_period = (express_remarks.spaces (".") as str) as op_period
  op_pipe = (express_remarks.spaces ("|") as str) as op_pipe
  op_query_begin = (express_remarks.spaces ("<" "*") as str) as op_query_begin
  op_query_end = (express_remarks.spaces ("*" ">") as str) as op_query_end
  op_question_mark = (express_remarks.spaces ("?") as str) as op_question_mark
  op_right_curly_brace = (express_remarks.spaces ("}") as str) as op_right_curly_brace
  op_rightbracket = (express_remarks.spaces ("]") as str) as op_rightbracket
  parameter = (expression) as parameter
  parameterId = (express_literals.simpleId) as parameterId
  parameterRef = (parameterId) as parameterRef
  parameterType = (generalizedTypes / namedTypes / simpleTypes) as parameterType
  population = (entityRef) as population
  precisionSpec = (numericExpression) as precisionSpec
  primary = (literal / (qualifiableFactor (0* qualifier) as qualifier)) as primary
  procedureCallStmt = ((builtInProcedure / procedureRef) [ actualParameterList ] express_operators.op_delim) as procedureCallStmt
  procedureDecl = (procedureHead algorithmHead (0* stmt) as stmt express_keywords.tEND_PROCEDURE express_operators.op_delim) as procedureDecl
  procedureHead = (express_keywords.tPROCEDURE procedureId ([ (express_operators.op_leftparen [ ((procedureHeadParameter 0* (express_operators.op_delim procedureHeadParameter)) as listOf_procedureHeadParameter) ] express_operators.op_rightparen) ]) as function_head_parameter_group (express_operators.op_delim) as op_delim2) as procedureHead
  procedureHeadParameter = ([ express_keywords.tVAR ] formalParameter) as procedureHeadParameter
  procedureId = (express_literals.simpleId) as procedureId
  procedureRef = (procedureId) as procedureRef
  qualifiableFactor = (functionCall / attributeRef / constantFactor / generalRef / population) as qualifiableFactor
  qualifiedAttribute = (express_keywords.tSELF groupQualifier attributeQualifier) as qualifiedAttribute
  qualifier = (attributeQualifier / groupQualifier / indexQualifier) as qualifier
  queryExpression = (express_keywords.tQUERY express_operators.op_leftparen variableId op_query_begin aggregateSource op_pipe logicalExpression express_operators.op_rightparen) as queryExpression
  realLiteral = (express_remarks.spaces (express_literals.digits "." [ express_literals.digits ] [ ((%x65 / %x45) [ sign ] express_literals.digits) ]) as str) as realLiteral
  realType = (express_keywords.tREAL [ (express_operators.op_leftparen precisionSpec express_operators.op_rightparen) ]) as realType
  redeclaredAttribute = (qualifiedAttribute [ (express_keywords.tRENAMED attributeId) ]) as redeclaredAttribute
  referenceClause = (express_keywords.tREFERENCE express_keywords.tFROM schemaRef [ (express_operators.op_leftparen (resourceOrRename 0* (express_operators.op_comma resourceOrRename)) as listOf_resourceOrRename express_operators.op_rightparen) ] express_operators.op_delim) as referenceClause
  referencedAttribute = (attributeRef / qualifiedAttribute) as referencedAttribute
  relOpExtended = (express_operators.relOp / express_keywords.tIN / express_keywords.tLIKE) as relOpExtended
  renameId = (constantId / entityId / functionId / procedureId / typeId) as renameId
  repeatControl = ([ incrementControl ] [ whileControl ] [ untilControl ]) as repeatControl
  repeatStmt = (express_keywords.tREPEAT repeatControl express_operators.op_delim (1* stmt) as stmt express_keywords.tEND_REPEAT (express_operators.op_delim) as op_delim2) as repeatStmt
  repetition = (numericExpression) as repetition
  resourceOrRename = (resourceRef [ (express_keywords.tAS renameId) ]) as resourceOrRename
  resourceRef = (constantRef / entityRef / functionRef / procedureRef / typeRef) as resourceRef
  returnStmt = (express_keywords.tRETURN [ (express_operators.op_leftparen expression express_operators.op_rightparen) ] express_operators.op_delim) as returnStmt
  ruleDecl = (ruleHead algorithmHead (0* stmt) as stmt whereClause express_keywords.tEND_RULE express_operators.op_delim) as ruleDecl
  ruleHead = (express_keywords.tRULE ruleId express_keywords.tFOR express_operators.op_leftparen (entityRef 0* (express_operators.op_comma entityRef)) as listOf_entityRef express_operators.op_rightparen express_operators.op_delim) as ruleHead
  ruleId = (express_literals.simpleId) as ruleId
  ruleLabelId = (express_literals.simpleId) as ruleLabelId
  ruleLabelRef = (ruleLabelId) as ruleLabelRef
  ruleRef = (ruleId) as ruleRef
  schemaBody = ((0* interfaceSpecification) as interfaceSpecification [ constantDecl ] (0* schemaBodyDeclaration) as schemaBodyDeclaration) as schemaBody
  schemaBodyDeclaration = (declaration / ruleDecl) as schemaBodyDeclaration
  schemaDecl = (express_keywords.tSCHEMA schemaId [ schemaVersionId ] express_operators.op_delim schemaBody express_keywords.tEND_SCHEMA (express_operators.op_delim) as op_delim2) as schemaDecl
  schemaId = (express_literals.simpleId) as schemaId
  schemaRef = (schemaId) as schemaRef
  schemaVersionId = (stringLiteral) as schemaVersionId
  selectExtension = (express_keywords.tBASED_ON typeRef [ (express_keywords.tWITH selectList) ]) as selectExtension
  selectList = (express_operators.op_leftparen (namedTypes 0* (express_operators.op_comma namedTypes)) as listOf_namedTypes express_operators.op_rightparen) as selectList
  selectType = ([ (express_keywords.tEXTENSIBLE [ express_keywords.tGENERIC_ENTITY ]) ] express_keywords.tSELECT [ (selectList / selectExtension) ]) as selectType
  selector = (expression) as selector
  setType = (express_keywords.tSET [ boundSpec ] express_keywords.tOF instantiableType) as setType
  sign = (%x2B / %x2D)
  simpleExpression = (term (0* (((express_operators.addLikeOp) as operator term) as item)) as rhs) as simpleExpression
  simpleFactor = (simpleFactorExpression / aggregateInitializer / entityConstructor / interval / queryExpression / stringLiteral / simpleFactorUnaryExpression / enumerationReference) as simpleFactor
  simpleFactorExpression = ((express_operators.op_leftparen expression express_operators.op_rightparen) / primary) as simpleFactorExpression
  simpleFactorUnaryExpression = (express_operators.unaryOp simpleFactorExpression) as simpleFactorUnaryExpression
  simpleTypes = (binaryType / booleanType / integerType / logicalType / numberType / realType / stringType) as simpleTypes
  skipStmt = (express_keywords.tSKIP express_operators.op_delim) as skipStmt
  stmt = (aliasStmt / assignmentStmt / caseStmt / compoundStmt / escapeStmt / ifStmt / nullStmt / procedureCallStmt / repeatStmt / returnStmt / skipStmt) as stmt
  stringLiteral = (express_literals.simpleStringLiteral / encodedStringLiteral) as stringLiteral
  stringType = (express_keywords.tSTRING [ widthSpec ]) as stringType
  subsuper = ([ supertypeConstraint ] [ subtypeDeclaration ]) as subsuper
  subtypeConstraint = (express_keywords.tOF express_operators.op_leftparen supertypeExpression express_operators.op_rightparen) as subtypeConstraint
  subtypeConstraintBody = ([ abstractSupertype ] [ totalOver ] [ (supertypeExpression express_operators.op_delim) ]) as subtypeConstraintBody
  subtypeConstraintDecl = (subtypeConstraintHead subtypeConstraintBody express_keywords.tEND_SUBTYPE_CONSTRAINT express_operators.op_delim) as subtypeConstraintDecl
  subtypeConstraintHead = (express_keywords.tSUBTYPE_CONSTRAINT subtypeConstraintId express_keywords.tFOR entityRef express_operators.op_delim) as subtypeConstraintHead
  subtypeConstraintId = (express_literals.simpleId) as subtypeConstraintId
  subtypeConstraintRef = (subtypeConstraintId) as subtypeConstraintRef
  subtypeDeclaration = ((express_keywords.tSUBTYPE express_keywords.tOF express_operators.op_leftparen entityRef 0* (express_operators.op_comma entityRef) express_operators.op_rightparen) as listOf_entityRef) as subtypeDeclaration
  supertypeConstraint = (abstractSupertypeDeclaration / abstractEntityDeclaration / supertypeRule) as supertypeConstraint
  supertypeExpression = (supertypeFactor (0* (((express_keywords.tANDOR) as operator supertypeFactor) as item)) as rhs) as supertypeExpression
  supertypeFactor = (supertypeTerm (0* (((express_keywords.tAND) as operator supertypeTerm) as item)) as rhs) as supertypeFactor
  supertypeRule = (express_keywords.tSUPERTYPE subtypeConstraint) as supertypeRule
  supertypeTerm = (entityRef / oneOf / (express_operators.op_leftparen supertypeExpression express_operators.op_rightparen)) as supertypeTerm
  syntax = ((express_remarks.spaces) as spaces (0* schemaDecl) as schemaDecl (express_remarks.spaces) as trailer) as syntax
  term = (factor (0* ((express_operators.multiplicationLikeOp factor) as item)) as rhs) as term
  totalOver = (express_keywords.tTOTAL_OVER express_operators.op_leftparen (entityRef 0* (express_operators.op_comma entityRef)) as listOf_entityRef express_operators.op_rightparen express_operators.op_delim) as totalOver
  typeDecl = (express_keywords.tTYPE typeId express_operators.op_equals underlyingType express_operators.op_delim [ whereClause ] express_keywords.tEND_TYPE (express_operators.op_delim) as op_delim2) as typeDecl
  typeId = (express_literals.simpleId) as typeId
  typeLabel = (typeLabelId / typeLabelRef) as typeLabel
  typeLabelId = (express_literals.simpleId) as typeLabelId
  typeLabelRef = (typeLabelId) as typeLabelRef
  typeRef = (typeId) as typeRef
  underlyingType = (concreteTypes / constructedTypes) as underlyingType
  uniqueClause = (express_keywords.tUNIQUE (uniqueRule express_operators.op_delim 0* (uniqueRule (express_operators.op_delim) as op_delim2)) as listOf_uniqueRule) as uniqueClause
  uniqueRule = ([ (ruleLabelId express_operators.op_colon) ] (referencedAttribute 0* (express_operators.op_comma referencedAttribute)) as listOf_referencedAttribute) as uniqueRule
  untilControl = (express_keywords.tUNTIL logicalExpression) as untilControl
  useClause = (express_keywords.tUSE express_keywords.tFROM schemaRef [ (express_operators.op_leftparen (namedTypeOrRename 0* (express_operators.op_comma namedTypeOrRename)) as listOf_namedTypeOrRename express_operators.op_rightparen) ] express_operators.op_delim) as useClause
  variableId = (express_literals.simpleId) as variableId
  variableRef = (variableId) as variableRef
  whereClause = (express_keywords.tWHERE (0* (domainRule express_operators.op_delim)) as listOf_domainRule) as whereClause
  whileControl = (express_keywords.tWHILE logicalExpression) as whileControl
  width = (numericExpression) as width
  widthSpec = (express_operators.op_leftparen width express_operators.op_rightparen [ express_keywords.tFIXED ]) as widthSpec
  skip = express_remarks.trivia
  entry syntax: syntax
}
