  generalRef = parameterRef / variableId
  population = entityRef
  qualifiableFactor = functionCall / attributeRef / constantFactor / generalRef / population
  op_period = spaces (".") as str
  attributeQualifier = op_period attributeRef
  op_double_backslash = spaces (%x5C) as str
  groupQualifier = op_double_backslash entityRef
  index = numericExpression
  index1 = index
  index2 = index
  op_rightbracket = spaces ("]") as str
  indexQualifier = op_leftbracket index1 0*1 (op_colon index2) op_rightbracket
  qualifier = attributeQualifier / groupQualifier / indexQualifier
  primary = literal / (qualifiableFactor (0* qualifier) as qualifier)
  simpleFactorExpression = (op_leftparen expression op_rightparen) / primary
  repetition = numericExpression
  element = expression 0*1 (op_colon repetition)
  aggregateInitializer = op_leftbracket 0*1 (element 0* (op_comma element)) as listOf_element op_rightbracket
  entityConstructor = entityRef op_leftparen 0*1 (expression 0* (op_comma expression)) as listOf_expression op_rightparen
  op_left_curly_brace = spaces ("{") as str
  intervalLow = simpleExpression
  intervalOp = op_less_equal / op_less_than
  intervalItem = simpleExpression
  intervalHigh = simpleExpression
  op_right_curly_brace = spaces ("}") as str
  interval = op_left_curly_brace intervalLow intervalOp intervalItem (intervalOp) as intervalOp2 intervalHigh op_right_curly_brace
  op_query_begin = spaces ("<" "*") as str
  aggregateSource = simpleExpression
  op_pipe = spaces ("|") as str
  logicalExpression = expression
  queryExpression = (spaces (("Q" / "q") ("U" / "u") ("E" / "e") ("R" / "r") ("Y" / "y") !((%x61-7A / %x41-5A / %x30-39 / "_"))) as str) as tQUERY op_leftparen variableId op_query_begin aggregateSource op_pipe logicalExpression op_rightparen
  op_plus = spaces ("+") as str
  op_minus = spaces ("-") as str
